-- Вид сверху: камера над игроком, направлена вниз на него и едет вместе с ним
------------------------------------------------------------
local TOPVIEW_BIND = "NPCWalkerTopView"
local topViewBound = false
local topViewForward = Vector3.new(0, 0, -1)
local savedCameraType = nil

local function topViewStep()
	local camera = workspace.CurrentCamera
	local root = getMyRoot()
	if not camera or not root then return end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local pos = root.Position
	camera.CFrame = CFrame.lookAt(pos + Vector3.new(0, state.topViewHeight, 0), pos, topViewForward)
end

local function setTopView(on)
	state.topView = on
	local camera = workspace.CurrentCamera
	if on then
		if topViewBound then return end
		if camera then
			savedCameraType = camera.CameraType
			-- направление «вверх экрана» берём из текущего взгляда камеры
			local look = camera.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			topViewForward = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
		end
		topViewBound = true
		RunService:BindToRenderStep(TOPVIEW_BIND, Enum.RenderPriority.Camera.Value + 1, topViewStep)
	else
		if topViewBound then
			topViewBound = false
			pcall(function() RunService:UnbindFromRenderStep(TOPVIEW_BIND) end)
		end
		if camera then
			if savedCameraType and savedCameraType ~= Enum.CameraType.Scriptable then
				camera.CameraType = savedCameraType
			else
				camera.CameraType = Enum.CameraType.Custom
			end
			local hum = getMyHumanoid()
			if hum then
				camera.CameraSubject = hum
			end
		end
	end
end

