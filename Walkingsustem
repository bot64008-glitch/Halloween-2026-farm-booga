local function shutdown()
	if not state.alive then return end
	state.running = false
	state.farm = false
	unbindMove()
	stopMoving()
	stopGlide()
	setAutoRotate(true)
	setTopView(false)
	stopFarmLoops()
	refreshId += 1
	deathToken += 1
	state.alive = false
	if diedConn then
		diedConn:Disconnect()
		diedConn = nil
	end
	for _, c in ipairs(farmConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(farmConns)
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(connections)
	table.clear(npcHumanoids)
	candidates = {}
	currentTarget = nil
	for _, c in ipairs(hookConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(hookConns)
	markerGui:Destroy()
	gui:Destroy()
end

