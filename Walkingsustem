		else
			add("Humanoid: нет" .. (c.hum and " (был при поиске!)" or ""))
		end
		add("HP-данные: " .. tostring(hpSignature(inst)))
		local attrs = {}
		for k, v in pairs(inst:GetAttributes()) do
			attrs[#attrs + 1] = k .. "=" .. tostring(v)
		end
		add("Атрибуты: " .. (#attrs > 0 and table.concat(attrs, ", ") or "нет"))
		local kids = {}
		for i, ch in ipairs(inst:GetChildren()) do
			if i > 25 then
				kids[#kids + 1] = "..."
				break
			end
			kids[#kids + 1] = ch.Name .. ":" .. ch.ClassName
		end
		add("Дети: " .. table.concat(kids, ", "))
		local r = c.root
		add(("Root: %s, поз %s, Anchored=%s"):format(r.Name, tostring(r.Position), tostring(r.Anchored)))
		add("Видимые части: " .. tostring(hasVisibleParts(inst)))
		add("Анимации идут: " .. tostring(animActive(inst)))
		add(("candAlive=%s, isAlive=%s, deadSet=%s, banned=%s"):format(
			tostring(candAlive(c)), tostring(isAlive(inst)), tostring(deadSet[inst] ~= nil), tostring(isBanned(c))
		))
	end)
	return table.concat(lines, "\n")
end

-- временно пропускаем цель и записываем причину + снимок
local function banTarget(target, reason)
	blacklist[target.inst] = os.clock() + GHOST_BAN_SECONDS
	table.insert(banLog, 1, { name = target.name, reason = reason, dump = describeTarget(target) })
	if #banLog > 5 then
		table.remove(banLog)
	end
	currentTarget = nil
	ghostTarget = nil
	watchTarget = nil
	progBestGap = nil
	setStatus(("Пропущена цель %s: %s"):format(target.name, reason), C.yellow)
end

-- быстрые проверки текущей цели; возвращает причину или nil
local function guardTarget(target, now)
	local inst, troot = target.inst, target.root
	if state.posCheck then
		local pos = troot.Position
		if pos ~= pos or pos.Y < workspace.FallenPartsDestroyHeight + 10 then
			return "позиция цели вне карты"
		end
	end
	if now - lastGuardCheck >= 0.5 then
		lastGuardCheck = now
		if state.visCheck then
			if hasVisibleParts(inst) then
				visFailCount = 0
			else
				visFailCount += 1
				if visFailCount >= 3 then
					return "у цели нет видимых частей"
				end
			end
		end
		if state.animCheck then
			if animActive(inst) == false then
				animFailCount += 1
				if animFailCount >= 6 then
					return "нет проигрываемых анимаций (3 с)"
				end
			else
				animFailCount = 0
			end
		end
	end
	return nil
end

