-- Режим СБРОСА: ресет персонажа (убить и возродить)
------------------------------------------------------------
local resetBusy = false
local goneCount = 0       -- сколько раз пропадали все цели с прошлого цикла
local cyclesDone = 0      -- сколько циклов сброса запущено
local refreshResetInfo = nil -- назначается позже (обновляет строку состояния в меню)

local function resetCharacter()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	pcall(function() hum.Health = 0 end)
	pcall(function() char:BreakJoints() end)
	return true
end

-- цикл: первый ресет сразу, второй через state.resetDelay секунд
local function runResetCycle()
	if resetBusy or not state.alive then return end
	resetBusy = true
	cyclesDone += 1
	if refreshResetInfo then refreshResetInfo() end
	task.spawn(function()
		resetCharacter() -- первый ресет
		local t0 = os.clock()
		while state.alive and os.clock() - t0 < state.resetDelay do
			task.wait(0.1)
		end
		if state.alive then
			resetCharacter() -- второй ресет
		end
		resetBusy = false
		if refreshResetInfo then refreshResetInfo() end
	end)
end

-- вызывается один раз при каждом «пропадании всех целей»
local function onTargetsGone()
	if not state.resetEnabled then return end
	goneCount += 1
	if goneCount >= state.resetEvery then
		goneCount = 0
		runResetCycle()
	end
	if refreshResetInfo then refreshResetInfo() end
end

