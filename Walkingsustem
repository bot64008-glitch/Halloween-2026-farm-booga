function M.resolvePath(path)
	local cur = workspace
	for seg in path:gmatch("[^%.%/>]+") do
		seg = trim(seg)
		if seg ~= "" and not (cur == workspace and seg:lower() == "workspace") then
			cur = cur:FindFirstChild(seg)
			if not cur then
				return nil
			end
		end
	end
	return cur
end

function M.collectFromContainer(container, out, seen, depth)
	if depth > 4 then return end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			if not seen[child] then
				local c = M.makeCandidate(child)
				if c then
					seen[child] = true
					out[#out + 1] = c
				end
			end
		elseif child:IsA("Folder") then
			M.collectFromContainer(child, out, seen, depth + 1)
		end
	end
end

-- Сканирование workspace с паузами, чтобы не фризить игру
function M.scanWorkspace(matchFn, id)
	local out = {}
	local n = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		n += 1
		if n % 500 == 0 then
			task.wait()
			if id ~= M.refreshId or not state.alive then
				return nil
			end
		end
		if inst:IsA("Model") and matchFn(inst) then
			local c = M.makeCandidate(inst)
			if c then
				out[#out + 1] = c
			end
		end
	end
	return out
end

function M.refreshCandidates()
	local id = M.refreshId
	local mode = state.mode
	local q = trim(state.queries[mode] or "")
	local out, note = {}, nil

	if mode == "humanoid" then
		local seen = {}
		for hum in pairs(M.npcHumanoids) do
			local model = hum.Parent
			if model and model:IsA("Model") and not seen[model] then
				local c = M.makeCandidate(model)
				if c then
					seen[model] = true
					out[#out + 1] = c
				end
			end
		end

	elseif mode == "auto" then
		out = M.scanWorkspace(function(m)
			return m:FindFirstChildOfClass("Humanoid") ~= nil
				or m:FindFirstChildOfClass("AnimationController") ~= nil
				or M.hasHpValue(m)
		end, id)

	elseif mode == "folder" then
		if q == "" then
			note = "Введите путь к папке"
		else
			local container = M.resolvePath(q)
			if not container then
				note = "Папка не найдена"
			else
				local seen = {}
				M.collectFromContainer(container, out, seen, 0)
				if #out == 0 and (container:IsA("Model") or container:IsA("BasePart")) then
					local c = M.makeCandidate(container)
					if c then out[1] = c end
				end
				if #out == 0 then
					note = "В папке нет подходящих NPC"
				end
			end
		end

	elseif mode == "name" then
		local names = {}
		for part in q:gmatch("[^,]+") do
			part = trim(part):lower()
			if part ~= "" then
				names[#names + 1] = part
			end
		end
		if #names == 0 then
			note = "Введите имя NPC"
		else
			out = M.scanWorkspace(function(m)
				local nm = m.Name:lower()
				for _, s in ipairs(names) do
					if nm:find(s, 1, true) then
						return true
					end
				end
				return false
			end, id)
		end

	elseif mode == "tag" then
		if q == "" then
			note = "Введите тег"
		else
			local seen = {}
			for _, inst in ipairs(CollectionService:GetTagged(q)) do
				if not seen[inst] and inst:IsDescendantOf(workspace) then
					local c = M.makeCandidate(inst)
					if c then
						seen[inst] = true
						out[#out + 1] = c
					end
				end
			end
			if #out == 0 then
				note = "Объекты с таким тегом не найдены"
			end
		end
	end

	if out == nil or id ~= M.refreshId then
		return -- поиск отменён (сменили режим/запрос)
	end
	M.candidates = out
	M.searchNote = note
	M.candidatesReady = true
	if M.onCandidatesUpdated then M.onCandidatesUpdated() end
end

task.spawn(function()
	while state.alive do
		M.refreshCandidates()
		local interval = (state.mode == "auto" or state.mode == "name") and 3 or 1
		local waited = 0
		while waited < interval and not M.forceRefresh and state.alive do
			waited += task.wait(0.1)
		end
		M.forceRefresh = false
	end
end)

