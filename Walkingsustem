-- безопасный поиск по пути (без бесконечного WaitForChild)
local function findPath(root, names)
	local cur = root
	for _, n in ipairs(names) do
		cur = cur and cur:FindFirstChild(n)
		if not cur then
			return nil
		end
	end
	return cur
end

-- имитация нажатия GUI-кнопки (firesignal + getconnections)
local function fireButton(btn)
	if not btn then return false end
	local ok = pcall(function()
		for _, sig in ipairs({ btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down }) do
			if firesignal then pcall(firesignal, sig) end
			if getconnections then
				for _, c in ipairs(getconnections(sig)) do
					pcall(function() c:Fire() end)
				end
			end
		end
	end)
	return ok
end

