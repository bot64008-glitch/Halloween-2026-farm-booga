local deathToken = 0
local diedConn = nil

local function onDeath()
	if not state.alive or not state.farm then return end
	deathToken += 1
	local token = deathToken
	local function active()
		return state.alive and state.farm and token == deathToken
	end

	-- клик в выбранную точку: через DEATH_CLICK_DELAY сек, DEATH_CLICK_COUNT нажатий с паузой
	if state.deathClick then
		task.spawn(function()
			task.wait(DEATH_CLICK_DELAY)
			for i = 1, DEATH_CLICK_COUNT do
				if not active() then return end
				local camera = workspace.CurrentCamera
				if camera then
					local vp = camera.ViewportSize
					clickAt(state.clickX * vp.X, state.clickY * vp.Y)
				end
				if i < DEATH_CLICK_COUNT then
					task.wait(DEATH_CLICK_GAP)
				end
			end
		end)
	end

	-- кнопка Ready: раз в секунду, 10 секунд
	if state.deathReady then
		task.spawn(function()
			local count = math.floor(DEATH_READY_DURATION / DEATH_READY_INTERVAL)
			for i = 1, count do
				if not active() then return end
				fireReady()
				if i < count then
					task.wait(DEATH_READY_INTERVAL)
				end
			end
		end)
	end

	-- клавиши: 2 -> (почти сразу) 1, раз в 5 секунд, 30 секунд
	if state.deathKeys then
		task.spawn(function()
			local cycles = math.floor(DEATH_KEYS_DURATION / DEATH_KEYS_INTERVAL)
			for i = 1, cycles do
				if not active() then return end
				local cycleStart = os.clock()
				pressKey(Enum.KeyCode.Two, 0x32)
				task.wait(KEYS_GAP)
				if not active() then return end
				pressKey(Enum.KeyCode.One, 0x31)
				if i < cycles then
					local rest = DEATH_KEYS_INTERVAL - (os.clock() - cycleStart)
					if rest > 0 then
						task.wait(rest)
					end
				end
			end
		end)
	end
end

