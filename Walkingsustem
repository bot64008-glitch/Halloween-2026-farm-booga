function M.isPlayerRelated(inst)
	local cur = inst
	while cur and cur ~= workspace do
		if cur:IsA("Model") and Players:GetPlayerFromCharacter(cur) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

function M.getRoot(model)
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	for _, n in ipairs({ "HumanoidRootPart", "RootPart", "Torso", "UpperTorso", "Head" }) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

-- признаки смерти, которые игры ставят на модель
M.DEAD_FLAGS = { "Dead", "IsDead", "Died", "dead", "isDead" }

-- Жив ли NPC: учитываем и Humanoid, и собственную систему HP (атрибуты/значения), и флаги смерти
function M.isAlive(inst)
	if not inst:IsDescendantOf(workspace) then
		return false
	end
	local hum = inst:FindFirstChildOfClass("Humanoid")
	if hum then
		if hum.Health <= 0 then return false end
		if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
	end
	for _, n in ipairs(M.DEAD_FLAGS) do
		if inst:GetAttribute(n) == true then
			return false
		end
	end
	for _, n in ipairs(M.HP_NAMES) do
		local a = inst:GetAttribute(n)
		if type(a) == "number" then
			return a > 0
		end
		local v = inst:FindFirstChild(n)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			return v.Value > 0
		end
	end
	return true
end

-- «подпись» здоровья цели: число (Humanoid.Health / HP) или nil, если данных нет
function M.hpSignature(inst)
	local hum = inst:FindFirstChildOfClass("Humanoid")
	if hum then return hum.Health end
	for _, n in ipairs(M.HP_NAMES) do
		local a = inst:GetAttribute(n)
		if type(a) == "number" then return a end
		local v = inst:FindFirstChild(n)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return v.Value end
	end
	return nil
end

function M.hasHpValue(inst)
	for _, n in ipairs(M.HP_NAMES) do
		if type(inst:GetAttribute(n)) == "number" then
			return true
		end
		local v = inst:FindFirstChild(n)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			return true
		end
	end
	return false
end

-- Горизонтальный "радиус" цели — нужен, чтобы считать расстояние от края
function M.calcRadius(inst, root)
	local size = root.Size
	if inst:IsA("Model") then
		local ok, s = pcall(function() return inst:GetExtentsSize() end)
		if ok and s then size = s end
	elseif inst:IsA("BasePart") then
		size = inst.Size
	end
	return (size.X + size.Z) / 4
end

function M.makeCandidate(inst)
	if not inst or not inst.Parent then return nil end
	if M.isPlayerRelated(inst) then return nil end
	local root
	if inst:IsA("Model") then
		root = M.getRoot(inst)
	elseif inst:IsA("BasePart") then
		root = inst
	else
		return nil
	end
	if not root then return nil end
	if not M.isAlive(inst) then return nil end
	return {
		inst = inst, root = root, name = inst.Name, key = inst.Name:lower(),
		hum = inst:FindFirstChildOfClass("Humanoid"), radius = M.calcRadius(inst, root),
	}
end

-- метки смерти от событий: [inst] = os.clock() момента смерти (помним DEAD_MEMORY секунд)
M.deadSet = setmetatable({}, { __mode = "k" })

-- цель жива и по-прежнему на карте (учитываем и пропавший Humanoid — «труп»)
function M.candAlive(c)
	local inst = c.inst
	if not inst.Parent or not c.root.Parent then return false end
	local dsince = M.deadSet[inst]
	if dsince and os.clock() - dsince < M.DEAD_MEMORY then return false end
	local hum = c.hum
	if hum and not hum:IsDescendantOf(inst) then return false end
	return M.isAlive(inst)
end

-- временно игнорируемые («зависшие») цели: [inst] = os.clock() до которого игнорируем
M.blacklist = setmetatable({}, { __mode = "k" })
function M.isBanned(c)
	local ban = M.blacklist[c.inst]
	return ban ~= nil and ban > os.clock()
end

