-- запоминаем имена целей, замеченных в радиусе (для вкладки ПРИОР.)
M.onCandidatesUpdated = function()
	local root = M.getMyRoot()
	if not root then return end
	local pos = root.Position
	local radius = state.farmRadius
	local present = {}
	local changed = false
	for _, c in ipairs(M.candidates) do
		if (c.root.Position - pos).Magnitude <= radius then
			present[c.key] = true
			if not M.seenNames[c.key] then
				M.seenNames[c.key] = c.name
				changed = true
			end
		end
	end
	M.presentNow = present
	if changed then M.queueSave() end
end

-- боссы с особым маршрутом (имя ищется по части, без учёта регистра)
M.BOSS_GUARDIAN = { corner = true, name = "The Undying Guardian" }
M.BOSS_KNIGHT = { corner = false, name = "The Spooky Knight" }

function M.bossSpec(c)
	if not c then return nil end
	local k = c.key
	if state.bossGuardian and k:find("undying guardian", 1, true) then
		return M.BOSS_GUARDIAN
	end
	if state.bossKnight and k:find("spooky knight", 1, true) then
		return M.BOSS_KNIGHT
	end
	return nil
end

-- уровень приоритета цели (0 — обычная). Действует только в радиусе farmRadius
function M.priorityLevel(c, d)
	if state.bossAutoPriority and d <= state.farmRadius and M.bossSpec(c) then
		return 100
	end
	if not state.priorityEnabled or d > state.farmRadius then
		return 0
	end
	return state.priorities[c.key] or 0
end

-- выбор цели: сначала по уровню приоритета, при равенстве — ближайшая.
-- дорогая проверка candAlive выполняется только для тех, кто мог бы стать лучшим
function M.findNearest(fromPos)
	local best, bestDist, bestLevel = nil, nil, -1
	for _, c in ipairs(M.candidates) do
		local root = c.root
		if c.inst.Parent and root.Parent and not M.isBanned(c) then
			local d = (root.Position - fromPos).Magnitude
			local level = M.priorityLevel(c, d)
			if (level > bestLevel or (level == bestLevel and d < bestDist)) and M.candAlive(c) then
				best, bestDist, bestLevel = c, d, level
			end
		end
	end
	return best, bestDist
end

-- зазор между краями меня и цели (по горизонтали)
function M.edgeGap(target, myRoot)
	local o = target.root.Position - myRoot.Position
	local flat = math.sqrt(o.X * o.X + o.Z * o.Z)
	local myR = (myRoot.Size.X + myRoot.Size.Z) / 4
	return math.max(0, flat - target.radius - myR)
end

