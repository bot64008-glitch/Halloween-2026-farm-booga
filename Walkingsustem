for _, inst in ipairs(workspace:GetDescendants()) do
	addHumanoid(inst)
end
track(workspace.DescendantAdded:Connect(addHumanoid))
track(workspace.DescendantRemoving:Connect(function(inst)
	npcHumanoids[inst] = nil
end))

local function requestRefresh()
	refreshId += 1
	forceRefresh = true
	candidates = {}
	candidatesReady = false
	searchNote = nil
end

local function resolvePath(path)
	local cur = workspace
	for seg in path:gmatch("[^%.%/>]+") do
		seg = trim(seg)
		if seg ~= "" and not (cur == workspace and seg:lower() == "workspace") then
			cur = cur:FindFirstChild(seg)
			if not cur then
				return nil
			end
		end
	end
	return cur
end

local function collectFromContainer(container, out, seen, depth)
	if depth > 4 then return end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			if not seen[child] then
				local c = makeCandidate(child)
				if c then
					seen[child] = true
					out[#out + 1] = c
				end
			end
		elseif child:IsA("Folder") then
			collectFromContainer(child, out, seen, depth + 1)
		end
	end
end

-- Сканирование workspace с паузами, чтобы не фризить игру
local function scanWorkspace(matchFn, id)
	local out = {}
	local n = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		n += 1
		if n % 500 == 0 then
			task.wait()
			if id ~= refreshId or not state.alive then
				return nil
			end
		end
		if inst:IsA("Model") and matchFn(inst) then
			local c = makeCandidate(inst)
			if c then
				out[#out + 1] = c
			end
		end
	end
	return out
end

local function refreshCandidates()
	local id = refreshId
	local mode = state.mode
	local q = trim(state.queries[mode] or "")
	local out, note = {}, nil

	if mode == "humanoid" then
		local seen = {}
		for hum in pairs(npcHumanoids) do
			local model = hum.Parent
			if model and model:IsA("Model") and not seen[model] then
				local c = makeCandidate(model)
				if c then
					seen[model] = true
					out[#out + 1] = c
				end
			end
		end

	elseif mode == "auto" then
		out = scanWorkspace(function(m)
			return m:FindFirstChildOfClass("Humanoid") ~= nil
				or m:FindFirstChildOfClass("AnimationController") ~= nil
				or hasHpValue(m)
		end, id)

	elseif mode == "folder" then
		if q == "" then
			note = "Введите путь к папке"
		else
			local container = resolvePath(q)
			if not container then
				note = "Папка не найдена"
			else
				local seen = {}
				collectFromContainer(container, out, seen, 0)
				if #out == 0 and (container:IsA("Model") or container:IsA("BasePart")) then
					local c = makeCandidate(container)
					if c then out[1] = c end
				end
				if #out == 0 then
					note = "В папке нет подходящих NPC"
				end
			end
		end

	elseif mode == "name" then
		local names = {}
		for part in q:gmatch("[^,]+") do
			part = trim(part):lower()
			if part ~= "" then
				names[#names + 1] = part
			end
		end
		if #names == 0 then
			note = "Введите имя NPC"
		else
			out = scanWorkspace(function(m)
				local nm = m.Name:lower()
				for _, s in ipairs(names) do
					if nm:find(s, 1, true) then
						return true
					end
				end
				return false
			end, id)
		end

	elseif mode == "tag" then
		if q == "" then
			note = "Введите тег"
		else
			local seen = {}
			for _, inst in ipairs(CollectionService:GetTagged(q)) do
				if not seen[inst] and inst:IsDescendantOf(workspace) then
					local c = makeCandidate(inst)
					if c then
						seen[inst] = true
						out[#out + 1] = c
					end
				end
			end
			if #out == 0 then
				note = "Объекты с таким тегом не найдены"
			end
		end
	end

	if out == nil or id ~= refreshId then
		return -- поиск отменён (сменили режим/запрос)
	end
	candidates = out
	searchNote = note
	candidatesReady = true
end

task.spawn(function()
	while state.alive do
		refreshCandidates()
		local interval = (state.mode == "auto" or state.mode == "name") and 3 or 1
		local waited = 0
		while waited < interval and not forceRefresh and state.alive do
			waited += task.wait(0.1)
		end
		forceRefresh = false
	end
end)

