-- Вспомогательные функции для NPC
------------------------------------------------------------
local function isPlayerRelated(inst)
	local cur = inst
	while cur and cur ~= workspace do
		if cur:IsA("Model") and Players:GetPlayerFromCharacter(cur) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function getRoot(model)
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	for _, n in ipairs({ "HumanoidRootPart", "RootPart", "Torso", "UpperTorso", "Head" }) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

-- Жив ли NPC (Humanoid, либо атрибут/значение Health/HP, иначе считаем живым)
local function isAlive(inst)
	local hum = inst:FindFirstChildOfClass("Humanoid")
	if hum then
		return hum.Health > 0
	end
	for _, n in ipairs(HP_NAMES) do
		local a = inst:GetAttribute(n)
		if type(a) == "number" then
			return a > 0
		end
		local v = inst:FindFirstChild(n)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			return v.Value > 0
		end
	end
	return true
end

local function hasHpValue(inst)
	for _, n in ipairs(HP_NAMES) do
		if type(inst:GetAttribute(n)) == "number" then
			return true
		end
		local v = inst:FindFirstChild(n)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			return true
		end
	end
	return false
end

-- Горизонтальный "радиус" цели (по размерам модели) — нужен, чтобы считать расстояние от края
local function calcRadius(inst, root)
	local size = root.Size
	if inst:IsA("Model") then
		local ok, s = pcall(function() return inst:GetExtentsSize() end)
		if ok and s then size = s end
	elseif inst:IsA("BasePart") then
		size = inst.Size
	end
	return (size.X + size.Z) / 4
end

local function makeCandidate(inst)
	if not inst or not inst.Parent then return nil end
	if isPlayerRelated(inst) then return nil end
	local root
	if inst:IsA("Model") then
		root = getRoot(inst)
	elseif inst:IsA("BasePart") then
		root = inst
	else
		return nil
	end
	if not root then return nil end
	if not isAlive(inst) then return nil end
	return { inst = inst, root = root, name = inst.Name, radius = calcRadius(inst, root) }
end

