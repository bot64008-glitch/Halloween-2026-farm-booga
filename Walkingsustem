------------------------------------------------------------
-- Геометрия безопасной зоны (в плоскости XZ)
------------------------------------------------------------
M.ZONE_CENTER = Vector3.zero
do
	local sx, sz = 0, 0
	for _, p in ipairs(M.ZONE_POINTS) do
		sx += p.X
		sz += p.Z
	end
	M.ZONE_CENTER = Vector3.new(sx / #M.ZONE_POINTS, 0, sz / #M.ZONE_POINTS)
end

function M.pointInZone(p)
	local inside = false
	local j = #M.ZONE_POINTS
	for i = 1, #M.ZONE_POINTS do
		local a, b = M.ZONE_POINTS[i], M.ZONE_POINTS[j]
		if (a.Z > p.Z) ~= (b.Z > p.Z) then
			local xAt = (b.X - a.X) * (p.Z - a.Z) / (b.Z - a.Z) + a.X
			if p.X < xAt then
				inside = not inside
			end
		end
		j = i
	end
	return inside
end

function M.closestOnSegment(p, a, b)
	local abx, abz = b.X - a.X, b.Z - a.Z
	local len2 = abx * abx + abz * abz
	local t = 0
	if len2 > 0 then
		t = ((p.X - a.X) * abx + (p.Z - a.Z) * abz) / len2
		t = math.clamp(t, 0, 1)
	end
	return Vector3.new(a.X + abx * t, 0, a.Z + abz * t)
end

-- куда идти, чтобы оказаться внутри зоны
function M.zoneGoalPoint(p)
	local best, bestD
	for i = 1, #M.ZONE_POINTS do
		local a = M.ZONE_POINTS[i]
		local b = M.ZONE_POINTS[(i % #M.ZONE_POINTS) + 1]
		local c = M.closestOnSegment(p, a, b)
		local d = (Vector3.new(c.X, 0, c.Z) - Vector3.new(p.X, 0, p.Z)).Magnitude
		if not bestD or d < bestD then
			best, bestD = c, d
		end
	end
	local toCenter = M.ZONE_CENTER - best
	if toCenter.Magnitude > 0.01 then
		best = best + toCenter.Unit * math.min(M.ZONE_INSET, toCenter.Magnitude)
	end
	return best
end

