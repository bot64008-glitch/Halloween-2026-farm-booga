-- Маршрут боссов: геометрия зоны и скольжение к точке
------------------------------------------------------------
local BOSS_APPROACH_BASE = 15  -- запас времени на «подойти к боссу» (плюс время пути)
local BOSS_HYST = 4            -- гистерезис «рядом с зоной» (студы)

-- расстояние от точки до зоны (0 — внутри)
local function zoneDistance(p)
	if pointInZone(p) then return 0 end
	local best
	for i = 1, #ZONE_POINTS do
		local a = ZONE_POINTS[i]
		local b = ZONE_POINTS[(i % #ZONE_POINTS) + 1]
		local c = closestOnSegment(p, a, b)
		local d = math.sqrt((c.X - p.X) ^ 2 + (c.Z - p.Z) ^ 2)
		if not best or d < best then
			best = d
		end
	end
	return best
end

-- ближайшая к p точка внутри зоны
local function clampToZone(p)
	if pointInZone(p) then
		return Vector3.new(p.X, 0, p.Z)
	end
	return zoneGoalPoint(p)
end

local function flatDist(a, b)
	return math.sqrt((a.X - b.X) ^ 2 + (a.Z - b.Z) ^ 2)
end

-- самый дальний от цели угол зоны (индекс) и расстояние до него
local function farCornerIndex(tpos)
	local bestI, bestD
	for i, pt in ipairs(ZONE_POINTS) do
		local d = flatDist(pt, tpos)
		if not bestD or d > bestD then
			bestI, bestD = i, d
		end
	end
	return bestI, bestD
end

-- точка чуть внутри зоны у угла
local function cornerPoint(i)
	local pt = ZONE_POINTS[i]
	local flatPt = Vector3.new(pt.X, 0, pt.Z)
	local toCenter = ZONE_CENTER - flatPt
	if toCenter.Magnitude < 0.01 then return flatPt end
	return flatPt + toCenter.Unit * math.min(ZONE_INSET + 0.5, toCenter.Magnitude)
end

-- плавно скользим к точке; возвращает true, если уже на месте
local function glideToPoint(hum, root, goal, dt)
	local p = root.Position
	local to = Vector3.new(goal.X - p.X, 0, goal.Z - p.Z)
	local dist = to.Magnitude
	if dist < 0.6 then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		return true
	end
	local dir = to.Unit
	hum:Move(dir, false)
	applyGlide(root, dir * approachSpeed(dist), dt)
	return false
end

local function step(dt)
	if not (state.alive and state.running) then return end

	-- новый персонаж (смерть/респавн): сбрасываем зону и отход — в зону после смерти не идём
	local char = player.Character
	if char ~= lastChar then
		lastChar = char
		resetLatches()
		glideVel = Vector3.zero
	end

	local hum, root = getMyHumanoid(), getMyRoot()
	if not hum or not root or hum.Health <= 0 then
		currentTarget = nil
		resetLatches()
		glideVel = Vector3.zero
		setStatus("Ждём персонажа...", C.sub)
		return
	end

	-- поворотом занимаемся сами, если включено «смотреть на цель»
	if state.face then
		if hum.AutoRotate then hum.AutoRotate = false end
	elseif not hum.AutoRotate then
		hum.AutoRotate = true
	end

	local hp = hum.Health

	-- ближайший NPC (пересчёт несколько раз в секунду или сразу, если цель пропала)
	local now = os.clock()
	local bossLocked = bossSpec(currentTarget) ~= nil -- босс «залипает»: не переключаемся, пока он жив
	if not targetValid(currentTarget) or (not bossLocked and now - lastRetarget > 0.15) then
		currentTarget = findNearest(root.Position)
		lastRetarget = now
	end
	local target = currentTarget

	-- слежение за целью: подписка на события смерти и проверки «призрака»
	if target then
		if target ~= watchTarget then
			watchTarget = target
			progBestGap, progSince, visFailCount, animFailCount = nil, now, 0, 0
			ghostTarget = nil
			if state.deathEvents then
				hookInst(target.inst, target.hum)
			end
		end
		local reason = guardTarget(target, now)
		if reason then
			banTarget(target, reason)
			target = nil
		end
	end

	-- безопасная зона: включаем при HP <= zoneHp, снимаем когда пропали все цели
	-- или когда HP выше порога держится zoneRecover секунд ПОДРЯД, пока персонаж стоит в зоне
	if state.zoneEnabled then
		if zoneActive then
			if not target and candidatesReady then
				noTargetTime += dt
				if noTargetTime >= ZONE_RELEASE_DELAY then
					zoneActive = false
					zoneArmed = false
					noTargetTime = 0
				end
			else
				noTargetTime = 0
			end

			if zoneActive then
				if hp > state.zoneHp and pointInZone(root.Position) then
					zoneRecoverTime += dt
					if zoneRecoverTime >= state.zoneRecover then
						zoneActive = false
						zoneArmed = true
						zoneRecoverTime = 0
						noTargetTime = 0
					end
				else
					zoneRecoverTime = 0
				end
			end
		else
			if hp > state.zoneHp then
				zoneArmed = true
			elseif zoneArmed and hp <= state.zoneHp then
				zoneActive = true
				noTargetTime = 0
				zoneRecoverTime = 0
			end
		end
	else
		zoneActive = false
	end

	-- отход: включаем при HP <= retreatHp, выключаем когда HP стало выше
	if state.retreat then
		if not retreating and hp <= state.retreatHp then
			retreating = true
		elseif retreating and hp > state.retreatHp then
			retreating = false
		end
	else
		retreating = false
	end

	-- направление на цель и поворот лицом к ней
	local flat = nil
	if target then
		local offset = target.root.Position - root.Position
		flat = Vector3.new(offset.X, 0, offset.Z)
		if state.face then
			faceDirection(root, flat, dt)
		end
	end

	-- 1) Безопасная зона (высший приоритет)
	if zoneActive then
		progBestGap = nil
		local p = root.Position
		if pointInZone(p) then
			hum:Move(Vector3.zero, false)
			applyGlide(root, Vector3.zero, dt)
			stuckTime = 0
			local suffix = ""
			if hp > state.zoneHp then
				suffix = (" • выход через %d с"):format(math.ceil(state.zoneRecover - zoneRecoverTime))
			end
			setStatus(("Зона: на месте (HP %d)%s"):format(math.floor(hp), suffix), C.yellow)
		else
			local goal = zoneGoalPoint(p)
			local to = Vector3.new(goal.X - p.X, 0, goal.Z - p.Z)
			local dist = to.Magnitude
			if dist > 0.05 then
				local dir = to.Unit
				local speed = approachSpeed(dist)
				hum:Move(dir, false)
				applyGlide(root, dir * speed, dt)
			else
				hum:Move(Vector3.zero, false)
				applyGlide(root, Vector3.zero, dt)
			end
			setStatus(("Зона: иду (HP %d)"):format(math.floor(hp)), C.yellow)
			checkStuck(hum, root, dt, true)
		end
		return
	end

	-- нет целей
	if not target then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		stuckTime = 0
		setStatus(searchNote or "Целей нет", C.text)
		return
	end

	-- 2) Отход от цели при низком HP (смотрим на цель, пятимся)
	if retreating then
		progBestGap = nil
		local away = -flat
		if away.Magnitude < 0.1 then
			local look = root.CFrame.LookVector
			away = -Vector3.new(look.X, 0, look.Z)
		end
		local dir = away.Unit
		hum:Move(dir, false)
		applyGlide(root, dir * state.glideSpeed, dt)
		setStatus(("Отход (HP %d)"):format(math.floor(hp)), C.yellow)
		checkStuck(hum, root, dt, true)
		return
	end

	-- 3) Особый маршрут боссов (The Undying Guardian / The Spooky Knight)
	local spec = bossSpec(target)
	if spec then
		if bossTarget ~= target then
			bossTarget = target
			bossEngaged = false
			bossCorner = nil
			bossPhaseSince = now
			if state.bossApproachFirst then
				bossPhase = "approach"
				local d = (target.root.Position - root.Position).Magnitude
				bossLimit = BOSS_APPROACH_BASE + (d / math.max(state.glideSpeed, 1)) * 1.5
			else
				bossPhase = "hold"
			end
		end
		if bossPhase == "approach" and now - bossPhaseSince > bossLimit then
			bossPhase = "hold" -- не дошли за отведённое время — всё равно уходим в зону
		end

		if bossPhase == "hold" then
			progBestGap = nil
			ghostTarget = nil
			local p = root.Position
			local tpos = target.root.Position

			-- всегда остаёмся в зоне; если вышли — возвращаемся
			if not pointInZone(p) then
				glideToPoint(hum, root, zoneGoalPoint(p), dt)
				setStatus("Босс: иду в зону", C.yellow)
				checkStuck(hum, root, dt, true)
				return
			end

			-- босс в зоне или рядом с ней? (с гистерезисом, чтобы не дёргаться на границе)
			local zd = zoneDistance(tpos)
			local near
			if bossEngaged then
				near = zd <= state.bossMargin + BOSS_HYST
			else
				near = zd <= state.bossMargin
			end
			bossEngaged = near

			if near then
				-- подходим к боссу, не выходя из зоны
				if edgeGap(target, root) <= state.stopDist then
					hum:Move(Vector3.zero, false)
					applyGlide(root, Vector3.zero, dt)
					stuckTime = 0
					setStatus("Босс: бью из зоны", C.yellow)
				else
					glideToPoint(hum, root, clampToZone(tpos), dt)
					setStatus("Босс: подхожу из зоны", C.yellow)
					checkStuck(hum, root, dt, true)
				end
				return
			end

			-- босс далеко от зоны
			if spec.corner then
				-- Undying Guardian: ждём в самом дальнем от него углу
				if not bossCorner or now - bossCornerAt > 1.5 then
					local idx, d = farCornerIndex(tpos)
					if not bossCorner then
						bossCorner = idx
					elseif idx ~= bossCorner and d > flatDist(ZONE_POINTS[bossCorner], tpos) + 6 then
						bossCorner = idx -- меняем угол только если новый заметно дальше
					end
					bossCornerAt = now
				end
				glideToPoint(hum, root, cornerPoint(bossCorner), dt)
				setStatus("Босс: жду в дальнем углу", C.yellow)
			else
				-- Spooky Knight: просто стоим в зоне
				hum:Move(Vector3.zero, false)
				applyGlide(root, Vector3.zero, dt)
				stuckTime = 0
				setStatus("Босс: жду в зоне", C.yellow)
			end
			return
		end
		-- фаза "approach": обычное движение к боссу ниже
	else
		bossTarget, bossPhase = nil, nil
	end

	-- 4) Обычное движение к цели
	local gap = edgeGap(target, root)
	local remaining = gap - state.stopDist

	if remaining <= 0.05 or flat.Magnitude < 0.1 then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		stuckTime = 0
		progBestGap = nil
		if bossPhase == "approach" then
			bossPhase = "hold" -- дошли до босса — сразу уходим в зону
		end
		setStatus("У цели: " .. target.name, C.text)

		-- страж «у цели»: HP не меняется и цель не двигается -> «призрак»
		if state.ghostFilter then
			local sig = hpSignature(target.inst)
			local tpos = target.root.Position
			if ghostTarget ~= target then
				ghostTarget, ghostSince, ghostSig, ghostPos = target, now, sig, tpos
			else
				if sig ~= ghostSig or (tpos - ghostPos).Magnitude > 0.5 then
					ghostSince, ghostSig, ghostPos = now, sig, tpos
				end
				-- если у цели нет данных о HP — ждём вдвое дольше
				local limit = (sig ~= nil) and state.ghostSeconds or state.ghostSeconds * 2
				if now - ghostSince >= limit then
					banTarget(target, ("стоим у цели %d с, она не меняется"):format(limit))
					return
				end
			end
		end
		return
	end

	ghostTarget = nil

	-- страж прогресса: зазор должен уменьшаться, иначе цель недоступна / «призрак»
	if state.progressCheck then
		if progBestGap == nil or gap < progBestGap - 1.0 then
			progBestGap, progSince = gap, now
		elseif now - progSince >= state.ghostSeconds then
			banTarget(target, ("нет прогресса в приближении %d с (зазор %.1f)"):format(state.ghostSeconds, gap))
			return
		end
	end

	local dir = flat.Unit
	local speed = approachSpeed(remaining)
	hum:Move(dir, false)
	applyGlide(root, dir * speed, dt)
	setStatus("К цели: " .. target.name, C.yellow)

	checkStuck(hum, root, dt, gap > 3.5)
end

local function start()
	if not state.alive or state.running then return end
	if MODES_BY_ID[state.mode].needsQuery then
		local newText = queryBox.Text
		if newText ~= (state.queries[state.mode] or "") then
			state.queries[state.mode] = newText
			requestRefresh()
		end
	end
	state.running = true
	currentTarget = nil
	stuckTime = 0
	resetLatches()
	glideVel = Vector3.zero
	lastStatus = nil
	setStatus("Запуск...", C.yellow)
	unbindMove()
	isBound = true
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Last.Value, step)
end

local function stop()
	if not state.running then return end
	state.running = false
	unbindMove()
	stopMoving()
	stopGlide()
	setAutoRotate(true)
	currentTarget = nil
	resetLatches()
	setStatus("Остановлено", C.sub)
end

