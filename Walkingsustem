	-- строки списка (создаются/удаляются по мере необходимости)
	local rows = {}

	local function destroyRow(key)
		local r = rows[key]
		if not r then return end
		for _, c in ipairs(r.conns) do
			pcall(function() c:Disconnect() end)
		end
		r.frame:Destroy()
		rows[key] = nil
	end

	local function setLevel(key, level)
		if level <= 0 then
			state.priorities[key] = nil
		else
			state.priorities[key] = math.clamp(math.floor(level + 0.5), 1, 99)
		end
		queueSave()
		if refreshPriorityList then refreshPriorityList() end
	end

	local function createRow(key)
		local r = { conns = {} }
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, 0, 0, 30)
		frame.BackgroundColor3 = C.card
		frame.BorderSizePixel = 0
		frame.Parent = p.frame
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
		r.frame = frame

		local nameBtn = Instance.new("TextButton")
		nameBtn.AutoButtonColor = false
		nameBtn.BackgroundTransparency = 1
		nameBtn.Size = UDim2.new(1, -96, 1, 0)
		nameBtn.Font = Enum.Font.Gotham
		nameBtn.TextSize = 11
		nameBtn.TextXAlignment = Enum.TextXAlignment.Left
		nameBtn.TextTruncate = Enum.TextTruncate.AtEnd
		nameBtn.Text = ""
		nameBtn.Parent = frame
		Instance.new("UIPadding", nameBtn).PaddingLeft = UDim.new(0, 10)
		r.nameBtn = nameBtn

		local plus = makeButton(frame, "+", C.btn, C.text, UDim2.fromOffset(22, 22), r.conns)
		plus.AnchorPoint = Vector2.new(1, 0.5)
		plus.Position = UDim2.new(1, -4, 0.5, 0)
		plus.TextSize = 14
		local minus = makeButton(frame, "−", C.btn, C.text, UDim2.fromOffset(22, 22), r.conns)
		minus.AnchorPoint = Vector2.new(1, 0.5)
		minus.Position = UDim2.new(1, -68, 0.5, 0)
		minus.TextSize = 14

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(1, 0.5)
		box.Position = UDim2.new(1, -30, 0.5, 0)
		box.Size = UDim2.fromOffset(34, 22)
		box.BackgroundColor3 = C.bg
		box.BorderSizePixel = 0
		box.Font = Enum.Font.GothamBold
		box.TextSize = 11
		box.TextColor3 = C.yellow
		box.ClearTextOnFocus = true
		box.Text = ""
		box.Parent = frame
		Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
		r.plus, r.minus, r.box = plus, minus, box

		r.conns[#r.conns + 1] = nameBtn.Activated:Connect(function()
			if state.priorities[key] then
				setLevel(key, 0)
			else
				setLevel(key, state.newPriorityLevel)
			end
		end)
		r.conns[#r.conns + 1] = plus.Activated:Connect(function()
			setLevel(key, (state.priorities[key] or 0) + 1)
		end)
		r.conns[#r.conns + 1] = minus.Activated:Connect(function()
			setLevel(key, (state.priorities[key] or 1) - 1)
		end)
		r.conns[#r.conns + 1] = box.FocusLost:Connect(function()
			local n = tonumber((box.Text:gsub(",", ".")))
			if n then
				setLevel(key, n)
			elseif refreshPriorityList then
				refreshPriorityList()
			end
		end)
		rows[key] = r
	end

	local function updateRow(key, rank)
		local r = rows[key]
		local level = state.priorities[key]
		local present = presentNow[key]
		r.frame.LayoutOrder = 100 + rank
		r.nameBtn.Text = (present and "● " or "   ") .. (seenNames[key] or key)
		r.nameBtn.TextColor3 = level and C.yellow or (present and C.text or C.sub)
		r.frame.BackgroundColor3 = level and Color3.fromRGB(46, 41, 20) or C.card
		r.plus.Visible = level ~= nil
		r.minus.Visible = level ~= nil
		r.box.Visible = level ~= nil
		if not r.box:IsFocused() then
			r.box.Text = level and tostring(level) or ""
		end
	end

	refreshPriorityList = function()
		local filter = nameBox.Text:lower()
		local keys = {}
		for k in pairs(seenNames) do keys[k] = true end
		for k in pairs(state.priorities) do keys[k] = true end

		local list = {}
		for k in pairs(keys) do
			if filter == "" or k:find(filter, 1, true) then
				list[#list + 1] = k
			end
		end
		table.sort(list, function(a, b)
			local la, lb = state.priorities[a] or 0, state.priorities[b] or 0
			if la ~= lb then return la > lb end
			local pa, pb = presentNow[a] and 1 or 0, presentNow[b] and 1 or 0
			if pa ~= pb then return pa > pb end
			return a < b
		end)

		local shown = {}
		for i = 1, math.min(#list, MAX_ROWS) do
			local k = list[i]
			shown[k] = true
			if not rows[k] then
				createRow(k)
			end
			updateRow(k, i)
		end
		for k in pairs(rows) do
			if not shown[k] then
				destroyRow(k)
			end
		end
		listHeader.Text = ("ЦЕЛИ (%d)  ( ● — сейчас рядом )"):format(#list)
	end

	local function addByName()
		local raw = trim(nameBox.Text)
		if raw == "" then return end
		local key = raw:lower()
		if not seenNames[key] then
			seenNames[key] = raw
		end
		state.priorities[key] = state.newPriorityLevel
		nameBox.Text = ""
		queueSave()
		refreshPriorityList()
	end

	track(addBtn.Activated:Connect(addByName))
	track(nameBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			addByName()
		end
	end))
	track(nameBox:GetPropertyChangedSignal("Text"):Connect(function()
		refreshPriorityList()
	end))

	-- пока вкладка открыта, список обновляется раз в секунду
	task.spawn(function()
		while state.alive do
			if p.frame.Visible then
				pcall(refreshPriorityList)
			end
			task.wait(1)
		end
	end)
	refreshPriorityList()
end

