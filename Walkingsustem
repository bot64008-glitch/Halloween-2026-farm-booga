	local function refreshPoint()
		local camera = workspace.CurrentCamera
		local vp = camera and camera.ViewportSize or Vector2.new(1280, 720)
		coordLabel.Text = ("X %.1f%%  Y %.1f%%   (%d, %d px)"):format(
			state.clickX * 100, state.clickY * 100,
			math.floor(state.clickX * vp.X + 0.5), math.floor(state.clickY * vp.Y + 0.5)
		)
		M.marker.Position = UDim2.fromOffset(state.clickX * vp.X, state.clickY * vp.Y)
		stepBtn.Text = ("Шаг %.1f%%"):format(POINT_STEPS[stepIndex] * 100)
	end

	local function movePoint(dx, dy)
		local s2 = POINT_STEPS[stepIndex]
		state.clickX = math.clamp(math.floor((state.clickX + dx * s2) * 1000 + 0.5) / 1000, 0, 1)
		state.clickY = math.clamp(math.floor((state.clickY + dy * s2) * 1000 + 0.5) / 1000, 0, 1)
		refreshPoint()
	end

