-- Скольжение (LinearVelocity в горизонтальной плоскости)
------------------------------------------------------------
M.glideAttach = nil
M.glideLV = nil
M.glideVel = Vector3.zero

function M.destroyGlide()
	if M.glideLV then
		M.glideLV:Destroy()
		M.glideLV = nil
	end
	if M.glideAttach then
		M.glideAttach:Destroy()
		M.glideAttach = nil
	end
end

function M.ensureGlide(root)
	if M.glideLV and M.glideLV.Parent and M.glideAttach and M.glideAttach.Parent == root then
		return
	end
	M.destroyGlide()
	M.glideAttach = Instance.new("Attachment")
	M.glideAttach.Name = "NPCWalkerAttachment"
	M.glideAttach.Parent = root

	M.glideLV = Instance.new("LinearVelocity")
	M.glideLV.Name = "NPCWalkerGlide"
	M.glideLV.Attachment0 = M.glideAttach
	M.glideLV.RelativeTo = Enum.ActuatorRelativeTo.World
	M.glideLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	M.glideLV.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	M.glideLV.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	M.glideLV.PlaneVelocity = Vector2.new(0, 0)
	M.glideLV.MaxForce = math.huge
	M.glideLV.Parent = root
end

function M.stopGlide()
	M.glideVel = Vector3.zero
	M.destroyGlide()
end

function M.applyGlide(root, desired, dt)
	local alpha = 1 - math.exp(-M.GLIDE_SMOOTH * dt)
	M.glideVel = M.glideVel:Lerp(desired, alpha)

	if desired.Magnitude < 0.01 and M.glideVel.Magnitude < 0.3 then
		M.glideVel = Vector3.zero
		if M.glideLV then
			M.glideLV.Enabled = false
		end
		return
	end

	M.ensureGlide(root)
	M.glideLV.Enabled = true
	M.glideLV.PlaneVelocity = Vector2.new(M.glideVel.X, M.glideVel.Z)
end

function M.faceDirection(root, flat, dt)
	if flat.Magnitude < 0.1 then return end
	local pos = root.Position
	local goal = CFrame.lookAt(pos, pos + flat)
	local alpha = 1 - math.exp(-M.FACE_SMOOTH * dt)
	root.CFrame = root.CFrame:Lerp(goal, alpha)
end

