-- Фарм: действия после смерти
------------------------------------------------------------
local deathToken = 0
local diedConn = nil

local function onDeath()
	if not state.alive or not state.farm then return end
	deathToken += 1
	local token = deathToken
	local function active()
		return state.alive and state.farm and token == deathToken
	end

	-- клик в выбранную точку: через DEATH_CLICK_DELAY сек, DEATH_CLICK_COUNT нажатий с паузой
	if state.deathClick then
		task.spawn(function()
			task.wait(DEATH_CLICK_DELAY)
			for i = 1, DEATH_CLICK_COUNT do
				if not active() then return end
				local camera = workspace.CurrentCamera
				if camera then
					local vp = camera.ViewportSize
					clickAt(state.clickX * vp.X, state.clickY * vp.Y)
				end
				if i < DEATH_CLICK_COUNT then
					task.wait(DEATH_CLICK_GAP)
				end
			end
		end)
	end

	-- кнопка Ready: раз в секунду, 10 секунд
	if state.deathReady then
		task.spawn(function()
			local count = math.floor(DEATH_READY_DURATION / DEATH_READY_INTERVAL)
			for i = 1, count do
				if not active() then return end
				fireReady()
				if i < count then
					task.wait(DEATH_READY_INTERVAL)
				end
			end
		end)
	end

	-- клавиши 2 -> (почти сразу) 1 по расписанию (раз в 5 секунд, 30 секунд).
	-- Нажимаем только когда персонаж жив; если инструмент не взялся в руки — до 3 попыток.
	if state.deathKeys then
		task.spawn(function()
			local cycles = math.floor(DEATH_KEYS_DURATION / DEATH_KEYS_INTERVAL)
			local t0 = os.clock()
			for i = 1, cycles do
				local waitFor = t0 + (i - 1) * DEATH_KEYS_INTERVAL - os.clock()
				if waitFor > 0 then
					task.wait(waitFor)
				end
				if not active() then return end
				if isCharAlive() then
					for attempt = 1, 3 do
						pressKey(Enum.KeyCode.Two, 0x32)
						task.wait(KEYS_GAP)
						if not active() then return end
						pressKey(Enum.KeyCode.One, 0x31)
						task.wait(0.25)
						if hasToolEquipped() or not isCharAlive() or not active() then
							break
						end
					end
				end
			end
		end)
	end
end

local function hookCharacter(char)
	if diedConn then
		diedConn:Disconnect()
		diedConn = nil
	end
	local hum = char:WaitForChild("Humanoid", 10)
	if hum and state.alive then
		diedConn = hum.Died:Connect(onDeath)
	end
end

