track(queryBox:GetPropertyChangedSignal("Text"):Connect(function()
	state.queries[state.mode] = queryBox.Text
end))
track(queryBox.FocusLost:Connect(function()
	state.queries[state.mode] = queryBox.Text
	requestRefresh()
end))

------------------------------------------------------------
-- Смерть персонажа: подключаем к текущему и каждому новому персонажу
------------------------------------------------------------
if player.Character then
	task.spawn(hookCharacter, player.Character)
end
track(player.CharacterAdded:Connect(function(char)
	glideVel = Vector3.zero
	task.spawn(hookCharacter, char)
end))

------------------------------------------------------------
-- Информация о ближайшей цели
------------------------------------------------------------
task.spawn(function()
	while state.alive do
		local root = getMyRoot()
		if root then
			local target = findNearest(root.Position)
			if target then
				local lvl = state.priorities[target.key]
				infoLabel.Text = ("%s%s · зазор %.1f м · целей %d"):format(
					lvl and ("★" .. lvl .. " ") or "", target.name, edgeGap(target, root), #candidates
				)
			else
				infoLabel.Text = searchNote or "Целей нет"
			end
		end
		task.wait(0.3)
	end
end)

