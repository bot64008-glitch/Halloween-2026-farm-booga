	for _, c in ipairs(M.candidates) do
		local root = c.root
		if c.inst.Parent and root.Parent
			and (root.Position - rootPos).Magnitude <= radius
			and not M.isBanned(c)
			and M.candAlive(c) then
			return true
		end
	end
	return false
end

