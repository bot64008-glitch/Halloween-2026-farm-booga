		lines[#lines + 1] = text
	end
	pcall(function()
		local inst = c.inst
		add(("Имя: %s (%s)"):format(inst.Name, inst.ClassName))
		add("Путь: " .. inst:GetFullName())
		add("В workspace: " .. tostring(inst:IsDescendantOf(workspace)))
