		marker.Position = UDim2.fromOffset(state.clickX * vp.X, state.clickY * vp.Y)
		stepBtn.Text = ("Шаг %.1f%%"):format(POINT_STEPS[stepIndex] * 100)
	end

	local function movePoint(dx, dy)
		local s = POINT_STEPS[stepIndex]
		state.clickX = math.clamp(math.floor((state.clickX + dx * s) * 1000 + 0.5) / 1000, 0, 1)
		state.clickY = math.clamp(math.floor((state.clickY + dy * s) * 1000 + 0.5) / 1000, 0, 1)
		refreshPoint()
	end

	local function makeArrow(text, x, y, dx, dy)
		local b = makeButton(panel, text, C.btn, C.yellow, UDim2.fromOffset(40, 28))
		b.Position = UDim2.fromOffset(x, y)
		b.TextSize = 14
		track(b.Activated:Connect(function()
			movePoint(dx, dy)
		end))
	end
	makeArrow("▲", 50, 24, 0, -1)
	makeArrow("◀", 8, 56, -1, 0)
	makeArrow("▼", 50, 56, 0, 1)
	makeArrow("▶", 92, 56, 1, 0)

	track(stepBtn.Activated:Connect(function()
		stepIndex = (stepIndex % #POINT_STEPS) + 1
		refreshPoint()
	end))

	setPointPanel = function(open)
		panel.Visible = open
		marker.Visible = open
		pointBtn.Text = open and "Точка клика: скрыть ▲" or "Выбрать точку клика ▼"
		if open then
			refreshPoint()
		end
	end
	setPointPanel(false)
end

