-- ближайшая цель (дорогая проверка isAlive — только для тех, кто ближе текущего лучшего)
local function findNearest(fromPos)
	local best, bestDist
	for _, c in ipairs(candidates) do
		local root = c.root
		if c.inst.Parent and root.Parent then
			local d = (root.Position - fromPos).Magnitude
			if (not bestDist or d < bestDist) and isAlive(c.inst) then
				best, bestDist = c, d
			end
		end
	end
	return best, bestDist
end

-- зазор между краями меня и цели (по горизонтали)
local function edgeGap(target, myRoot)
	local o = target.root.Position - myRoot.Position
	local flat = math.sqrt(o.X * o.X + o.Z * o.Z)
	local myR = (myRoot.Size.X + myRoot.Size.Z) / 4
	return math.max(0, flat - target.radius - myR)
end

