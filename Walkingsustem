	while state.alive do
		local root = getMyRoot()
		if root then
			local target = findNearest(root.Position)
			if target then
				infoLabel.Text = ("%s · зазор %.1f м · целей %d"):format(
					target.name, edgeGap(target, root), #candidates
				)
			else
				infoLabel.Text = searchNote or "Целей нет"
			end
		end
		task.wait(0.3)
	end
end)

