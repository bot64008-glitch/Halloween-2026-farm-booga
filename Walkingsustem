-- нажатие клавиши (keyCode — Enum.KeyCode, vk — код для keypress экзекутора)
local function pressKey(keyCode, vk)
	if VIM then
		local ok = pcall(function()
			VIM:SendKeyEvent(true, keyCode, false, game)
			task.wait(0.03)
			VIM:SendKeyEvent(false, keyCode, false, game)
		end)
		if ok then return end
	end
	if keypress and keyrelease then
		pcall(function()
			keypress(vk)
			task.wait(0.03)
			keyrelease(vk)
		end)
	end
end

-- клик в центр экрана
local function clickCenter()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local vp = camera.ViewportSize
	local x, y = vp.X / 2, vp.Y / 2

	if VIM then
		local ok = pcall(function()
			VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
			VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
		end)
		if ok then return end
	end

	-- запасные варианты
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then
		pcall(function() tool:Activate() end)
	elseif mouse1click then
		pcall(mouse1click)
	end
end

-- один клик в произвольную точку экрана (координаты в пикселях)
local function clickAt(x, y)
	if VIM then
		local ok = pcall(function()
			VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
			VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
		end)
		if ok then return end
	end
	-- запасной вариант для экзекуторов без VirtualInputManager
	if mousemoveabs and mouse1click then
		pcall(function()
			mousemoveabs(x, y)
			mouse1click()
		end)
	end
end

-- есть ли живые цели в радиусе FARM_RADIUS
-- оптимизация: сначала дешёвая проверка расстояния, и только потом isAlive
local function hasTargetsInRadius(rootPos)
	for _, c in ipairs(candidates) do
		local root = c.root
		if c.inst.Parent and root.Parent
			and (root.Position - rootPos).Magnitude <= FARM_RADIUS
			and isAlive(c.inst) then
			return true
		end
	end
	return false
end

