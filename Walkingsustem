-- Скольжение (LinearVelocity в горизонтальной плоскости)
------------------------------------------------------------
local glideAttach = nil
local glideLV = nil
local glideVel = Vector3.zero

local function destroyGlide()
	if glideLV then
		glideLV:Destroy()
		glideLV = nil
	end
	if glideAttach then
		glideAttach:Destroy()
		glideAttach = nil
	end
end

local function ensureGlide(root)
	if glideLV and glideLV.Parent and glideAttach and glideAttach.Parent == root then
		return
	end
	destroyGlide()
	glideAttach = Instance.new("Attachment")
	glideAttach.Name = "NPCWalkerAttachment"
	glideAttach.Parent = root

	glideLV = Instance.new("LinearVelocity")
	glideLV.Name = "NPCWalkerGlide"
	glideLV.Attachment0 = glideAttach
	glideLV.RelativeTo = Enum.ActuatorRelativeTo.World
	glideLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	glideLV.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	glideLV.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	glideLV.PlaneVelocity = Vector2.new(0, 0)
	glideLV.MaxForce = math.huge
	glideLV.Parent = root
end

local function stopGlide()
	glideVel = Vector3.zero
	destroyGlide()
end

local function applyGlide(root, desired, dt)
	local alpha = 1 - math.exp(-GLIDE_SMOOTH * dt)
	glideVel = glideVel:Lerp(desired, alpha)

	if desired.Magnitude < 0.01 and glideVel.Magnitude < 0.3 then
		glideVel = Vector3.zero
		if glideLV then
			glideLV.Enabled = false
		end
		return
	end

	ensureGlide(root)
	glideLV.Enabled = true
	glideLV.PlaneVelocity = Vector2.new(glideVel.X, glideVel.Z)
end

local function faceDirection(root, flat, dt)
	if flat.Magnitude < 0.1 then return end
	local pos = root.Position
	local goal = CFrame.lookAt(pos, pos + flat)
	local alpha = 1 - math.exp(-FACE_SMOOTH * dt)
	root.CFrame = root.CFrame:Lerp(goal, alpha)
end

