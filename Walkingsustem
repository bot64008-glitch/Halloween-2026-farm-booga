-- СБРОС ФАРМА: пересоздаём кнопку, циклы, списки целей, чистим память и продолжаем фарм
local lastReset = 0
local function resetFarm()
	if farmResetting or not state.alive or not state.farm then return end
	farmResetting = true
	lastReset = os.clock()
	task.spawn(function()
		stopFarmLoops()                  -- останавливаем старые циклы (кликер и скип)
		buildFarmButton()                -- пересоздаём кнопку фарма
		requestRefresh()                 -- сбрасываем список целей
		rebuildHumanoidSet()             -- пересобираем список Humanoid
		pcall(collectgarbage, "collect") -- чистим память (где разрешено)
		task.wait(FARM_RESET_PAUSE)      -- даём игре "выдохнуть"
		resetCount += 1
		farmResetting = false
		if state.alive and state.farm then
			startFarmLoops()             -- сразу продолжаем фарм
		end
		refreshFarmBtn()
	end)
end

-- Монитор FPS: считаем кадры, раз в секунду проверяем порог.
-- Сброс — только если FPS <= FPS_RESET_BELOW держится FPS_LOW_SECONDS секунд подряд.
do
	local frames, accum = 0, 0
	local lowSeconds = 0
	track(RunService.RenderStepped:Connect(function(dt)
		frames += 1
		accum += dt
		if accum < 1 then return end
		local fps = frames / accum
		frames, accum = 0, 0

		fpsLabel.Text = ("FPS %d"):format(math.floor(fps + 0.5))
		fpsLabel.TextColor3 = fps <= FPS_RESET_BELOW and Color3.fromRGB(255, 200, 120) or Color3.new(1, 1, 1)

		if state.farm and state.autoReset and not farmResetting then
			if fps <= FPS_RESET_BELOW then
				lowSeconds += 1
			else
				lowSeconds = 0
			end
			if lowSeconds >= FPS_LOW_SECONDS and os.clock() - lastReset >= FARM_RESET_COOLDOWN then
				lowSeconds = 0
				resetFarm()
			end
		else
			lowSeconds = 0
		end
	end))
end

------------------------------------------------------------
-- Скольжение (LinearVelocity в горизонтальной плоскости)
------------------------------------------------------------
local glideAttach = nil
local glideLV = nil
local glideVel = Vector3.zero   -- текущая (сглаженная) горизонтальная скорость

local function destroyGlide()
	if glideLV then
		glideLV:Destroy()
		glideLV = nil
	end
	if glideAttach then
		glideAttach:Destroy()
		glideAttach = nil
	end
end

local function ensureGlide(root)
	if glideLV and glideLV.Parent and glideAttach and glideAttach.Parent == root then
		return
	end
	destroyGlide()
	glideAttach = Instance.new("Attachment")
	glideAttach.Name = "NPCWalkerAttachment"
	glideAttach.Parent = root

	glideLV = Instance.new("LinearVelocity")
	glideLV.Name = "NPCWalkerGlide"
	glideLV.Attachment0 = glideAttach
	glideLV.RelativeTo = Enum.ActuatorRelativeTo.World
	glideLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	glideLV.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	glideLV.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	glideLV.PlaneVelocity = Vector2.new(0, 0)
	glideLV.MaxForce = math.huge
	glideLV.Parent = root
end

local function stopGlide()
	glideVel = Vector3.zero
	destroyGlide()
end

-- desired — желаемая горизонтальная скорость (Vector3 с Y = 0)
local function applyGlide(root, desired, dt)
	local alpha = 1 - math.exp(-GLIDE_SMOOTH * dt)
	glideVel = glideVel:Lerp(desired, alpha)

	if desired.Magnitude < 0.01 and glideVel.Magnitude < 0.3 then
		-- остановились: отпускаем персонажа
		glideVel = Vector3.zero
		if glideLV then
			glideLV.Enabled = false
		end
		return
	end

	ensureGlide(root)
	glideLV.Enabled = true
	glideLV.PlaneVelocity = Vector2.new(glideVel.X, glideVel.Z)
end

-- плавный поворот персонажа лицом в направлении flat (горизонтальный вектор)
local function faceDirection(root, flat, dt)
	if flat.Magnitude < 0.1 then return end
	local pos = root.Position
	local goal = CFrame.lookAt(pos, pos + flat)
	local alpha = 1 - math.exp(-FACE_SMOOTH * dt)
	root.CFrame = root.CFrame:Lerp(goal, alpha)
end

------------------------------------------------------------
-- Движение: плавное скольжение к цели, позиция цели читается каждый кадр
------------------------------------------------------------
local BIND_NAME = "NPCWalkerMove"
local currentTarget = nil
local lastRetarget = 0
local stuckTime = 0
local isBound = false
local retreating = false

-- безопасная зона
local zoneActive = false     -- сейчас действует ограничение зоны
local zoneArmed = true       -- можно ли включить зону (после снятия нужно, чтобы HP стало > ZONE_HP)
local noTargetTime = 0       -- сколько секунд подряд нет целей (для снятия ограничения)
local zoneRecoverTime = 0    -- сколько секунд подряд HP выше ZONE_HP в зоне (для выхода из зоны)
local lastChar = nil         -- последний известный персонаж (чтобы заметить смерть/респавн)

local function setAutoRotate(value)
	local hum = getMyHumanoid()
	if hum then
		hum.AutoRotate = value
	end
end

local function stopMoving()
	local hum = getMyHumanoid()
	if hum then
		hum:Move(Vector3.zero, false)
	end
end

local function unbindMove()
	if isBound then
		isBound = false
		pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
	end
end

local function targetValid(t)
	return t ~= nil and t.inst.Parent ~= nil and t.root.Parent ~= nil and isAlive(t.inst)
end

-- прыжок, если застряли (скорость почти нулевая при условии cond)
local function checkStuck(hum, root, dt, cond)
	if state.autoJump and cond then
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		if speed < 1.5 then
			stuckTime += dt
			if stuckTime > 0.35 then
				hum.Jump = true
				stuckTime = 0
			end
		else
			stuckTime = 0
		end
	else
		stuckTime = 0
	end
end

local function resetLatches()
	retreating = false
	zoneActive = false
	zoneArmed = true
	noTargetTime = 0
	zoneRecoverTime = 0
end

local function step(dt)
	if not (state.alive and state.running) then return end

	-- новый персонаж (смерть/респавн): сбрасываем зону и отход — в зону после смерти не идём
	local char = player.Character
	if char ~= lastChar then
		lastChar = char
		resetLatches()
		glideVel = Vector3.zero
	end

	local hum, root = getMyHumanoid(), getMyRoot()
	if not hum or not root or hum.Health <= 0 then
		currentTarget = nil
		resetLatches()
		glideVel = Vector3.zero
		setStatus("💤 Ждём персонажа...", COLORS.subtext)
		return
	end

	-- поворотом занимаемся сами (чтобы всегда смотреть на цель)
	if hum.AutoRotate then
		hum.AutoRotate = false
	end

	local hp = hum.Health

	-- пересчитываем ближайшего NPC несколько раз в секунду (или сразу, если цель пропала)
	local now = os.clock()
	if not targetValid(currentTarget) or now - lastRetarget > 0.15 then
		currentTarget = findNearest(root.Position)
		lastRetarget = now
	end
	local target = currentTarget

	-- безопасная зона: включаем при HP <= ZONE_HP, снимаем когда пропали все цели
	if state.zoneEnabled then
		if zoneActive then
			if not target and candidatesReady then
				noTargetTime += dt
				if noTargetTime >= ZONE_RELEASE_DELAY then
					zoneActive = false
					zoneArmed = false -- повторно включится только после того, как HP станет выше порога
					noTargetTime = 0
				end
			else
				noTargetTime = 0
			end

			-- отсчёт идёт ТОЛЬКО когда персонаж уже стоит в зоне и HP выше порога.
			-- ZONE_RECOVER_SECONDS секунд подряд -> выходим из зоны и снова идём к цели;
			-- если HP опять упадёт до ZONE_HP и ниже, зона включится заново
			if zoneActive then
				if hp > ZONE_HP and pointInZone(root.Position) then
					zoneRecoverTime += dt
					if zoneRecoverTime >= ZONE_RECOVER_SECONDS then
						zoneActive = false
						zoneArmed = true
						zoneRecoverTime = 0
						noTargetTime = 0
					end
				else
					zoneRecoverTime = 0 -- HP низкий или персонаж ещё не в зоне: отсчёта нет
				end
			end
		else
			if hp > ZONE_HP then
				zoneArmed = true
			elseif zoneArmed and hp <= ZONE_HP then
				zoneActive = true
				noTargetTime = 0
				zoneRecoverTime = 0
			end
		end
	else
		zoneActive = false
	end

	-- отступление: включаем при HP <= RETREAT_HP, выключаем когда HP стало выше
	if state.retreat then
		if not retreating and hp <= RETREAT_HP then
			retreating = true
		elseif retreating and hp > RETREAT_HP then
			retreating = false
		end
	else
		retreating = false
	end

	-- направление на цель (позиция NPC читается КАЖДЫЙ кадр) и поворот лицом к ней
	local flat = nil
	if target then
		local offset = target.root.Position - root.Position
		flat = Vector3.new(offset.X, 0, offset.Z)
		faceDirection(root, flat, dt)
	end

	-- 1) Безопасная зона (высший приоритет)
	if zoneActive then
		local p = root.Position
		local inside = pointInZone(p)
		if inside then
			hum:Move(Vector3.zero, false)
			applyGlide(root, Vector3.zero, dt)
			stuckTime = 0
			local suffix = ""
			if hp > ZONE_HP then
				suffix = (" • выход через %d с"):format(math.ceil(ZONE_RECOVER_SECONDS - zoneRecoverTime))
			end
			setStatus(("🛡 В зоне (HP %d)%s"):format(math.floor(hp), suffix), COLORS.orange)
		else
			local goal = zoneGoalPoint(p)
			local to = Vector3.new(goal.X - p.X, 0, goal.Z - p.Z)
			local dist = to.Magnitude
			if dist > 0.05 then
				local dir = to.Unit
				local speed = math.clamp(dist * GLIDE_K, GLIDE_MIN_SPEED, state.glideSpeed)
				hum:Move(dir, false)
				applyGlide(root, dir * speed, dt)
			else
				hum:Move(Vector3.zero, false)
				applyGlide(root, Vector3.zero, dt)
			end
			setStatus(("🛡 Иду в зону (HP %d)"):format(math.floor(hp)), COLORS.orange)
			checkStuck(hum, root, dt, true)
		end
		return
	end

	-- нет целей
	if not target then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		stuckTime = 0
		setStatus("🔍 " .. (searchNote or "NPC не найдены"), COLORS.orange)
		return
	end

	-- 2) Отступление при HP <= 50: скользим в сторону, противоположную цели (но смотрим на неё)
	if retreating then
		local away = -flat
		if away.Magnitude < 0.1 then
			local look = root.CFrame.LookVector
			away = -Vector3.new(look.X, 0, look.Z)
		end
		local dir = away.Unit
		hum:Move(dir, false) -- только для анимации
		applyGlide(root, dir * state.glideSpeed, dt)
		setStatus(("🏃 Отступаю (HP %d)"):format(math.floor(hp)), COLORS.orange)
		checkStuck(hum, root, dt, true)
		return
	end

	-- 3) Обычное движение к цели
	local gap = edgeGap(target, root)
	local remaining = gap - state.stopDist

	-- дошли до нужного зазора
	if remaining <= 0.05 or flat.Magnitude < 0.1 then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		stuckTime = 0
		setStatus("✅ Дошёл до: " .. target.name, COLORS.green)
		return
	end

	-- скорость: максимум glideSpeed, плавное торможение при подходе
	local dir = flat.Unit
	local speed = math.clamp(remaining * GLIDE_K, GLIDE_MIN_SPEED, state.glideSpeed)
	hum:Move(dir, false) -- только для анимации
	applyGlide(root, dir * speed, dt)
	setStatus("💨 Скольжу к: " .. target.name, COLORS.green)

	-- застряли (упёрлись в препятствие) — прыгаем
	checkStuck(hum, root, dt, gap > 3.5)
end

local function start()
	if not state.alive or state.running then return end
	-- забираем актуальный текст из поля ввода
	if MODES_BY_ID[state.mode].needsQuery then
		local newText = queryBox.Text
		if newText ~= (state.queries[state.mode] or "") then
			state.queries[state.mode] = newText
			requestRefresh()
		end
	end
	state.running = true
	currentTarget = nil
	stuckTime = 0
	resetLatches()
	glideVel = Vector3.zero
	lastStatus = nil
	setStatus("💨 Запуск...", COLORS.green)
	unbindMove()
	isBound = true
	-- после обработки управления игрока, чтобы наш ввод не перебивался
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Last.Value, step)
end

local function stop()
	if not state.running then return end
	state.running = false
	unbindMove()
	stopMoving()
	stopGlide()
	setAutoRotate(true)
	currentTarget = nil
	resetLatches()
	setStatus("⏸ Остановлено", COLORS.subtext)
end

------------------------------------------------------------
-- Полное выключение
------------------------------------------------------------
local function shutdown()
	if not state.alive then return end
	state.running = false
	state.farm = false
	unbindMove()
	stopMoving()
	stopGlide()
	setAutoRotate(true)
	stopFarmLoops()
	refreshId += 1
	deathToken += 1
	state.alive = false
	if diedConn then
		diedConn:Disconnect()
		diedConn = nil
	end
	for _, c in ipairs(farmConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(farmConns)
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(connections)
	table.clear(npcHumanoids)
	candidates = {}
	currentTarget = nil
	markerGui:Destroy()
	gui:Destroy()
end

