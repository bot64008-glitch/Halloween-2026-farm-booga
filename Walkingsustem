------------------------------------------------------------
-- Полное выключение
------------------------------------------------------------
function M.shutdown()
	if not state.alive then return end
	state.running = false
	state.farm = false
	M.unbindMove()
	M.stopMoving()
	M.stopGlide()
	M.setAutoRotate(true)
	M.setTopView(false)
	M.stopFarmLoops()
	M.refreshId += 1
	M.deathToken += 1
	state.alive = false
	if M.diedConn then
		M.diedConn:Disconnect()
		M.diedConn = nil
	end
	for _, c in ipairs(M.farmConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(M.farmConns)
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(connections)
	table.clear(M.npcHumanoids)
	M.candidates = {}
	M.currentTarget = nil
	for _, c in ipairs(M.hookConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(M.hookConns)
	M.markerGui:Destroy()
	M.gui:Destroy()
end

