task.spawn(function()
	while state.alive do
		local root = M.getMyRoot()
		if root then
			local target = M.findNearest(root.Position)
			if target then
				local lvl = state.priorities[target.key]
				M.infoLabel.Text = ("%s%s · зазор %.1f м · целей %d"):format(
					lvl and ("★" .. lvl .. " ") or "", target.name, M.edgeGap(target, root), #M.candidates
				)
			else
				M.infoLabel.Text = M.searchNote or "Целей нет"
			end
		end
		task.wait(0.3)
	end
end)

