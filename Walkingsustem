local function changeDist(dir)
	local s = state.stopDist
	local stepSize = ((dir > 0 and s >= 2) or (dir < 0 and s > 2)) and 0.5 or 0.1
	s = s + dir * stepSize
	s = math.floor(s * 10 + 0.5) / 10
	state.stopDist = math.clamp(s, 0, 30)
end

local function changeSpeed(dir)
	local s = state.glideSpeed
	local stepSize = s >= 100 and 10 or 5
	if dir < 0 and s <= 100 then stepSize = 5 end
	state.glideSpeed = math.clamp(s + dir * stepSize, 5, 300)
end

