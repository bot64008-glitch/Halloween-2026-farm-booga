-- ФАРМ: кнопка (пересоздаваемая), циклы и авто-сброс по FPS
------------------------------------------------------------
local farmBtn = nil
local farmOrder = 0
local farmConns = {}        -- соединения именно кнопки фарма
local farmGen = 0           -- «поколение» циклов: старые циклы сами завершаются
local farmResetting = false
local resetCount = 0
local watchArmed = true     -- взведён ли счётчик «пропаданий целей» (цели были с прошлого раза)

local function refreshFarmBtn()
	if not farmBtn then return end
	local on = state.farm
	if farmResetting and on then
		farmBtn.Text = "СБРОС ФАРМА..."
		farmBtn.BackgroundColor3 = C.btn
		farmBtn.TextColor3 = C.yellow
		return
	end
	local suffix = (on and resetCount > 0) and ("  (сбросов: " .. resetCount .. ")") or ""
	farmBtn.Text = (on and "ФАРМ: ВКЛ" or "ФАРМ: ВЫКЛ") .. suffix
	farmBtn.TextColor3 = on and C.black or C.text
	TweenService:Create(farmBtn, TweenInfo.new(0.12), {
		BackgroundColor3 = on and C.yellow or C.btn,
	}):Play()
end

local function flashFarm(text)
	if farmBtn then
		farmBtn.Text = text
	end
	task.delay(0.8, function()
		if state.alive then refreshFarmBtn() end
	end)
end

-- цикл авто-кликера (постоянные клики)
local function clickLoop(gen)
	while state.alive and state.farm and gen == farmGen do
		if state.autoClick then
			clickCenter()
			task.wait(1 / math.max(1, state.clicksPerSec))
		else
			task.wait(0.2)
		end
	end
end

-- цикл слежения: пропадание всех целей -> скип и/или счётчик сброса
local function watchLoop(gen)
	local emptySince = nil
	local lastSkip = 0
	local firstSkip = false
	while state.alive and state.farm and gen == farmGen do
		if (state.autoSkip or state.resetEnabled) and candidatesReady and not searchNote then
			local root = getMyRoot()
			if root then
				if hasTargetsInRadius(root.Position) then
					emptySince = nil
					watchArmed = true
				else
					local now = os.clock()
					emptySince = emptySince or now
					if now - emptySince >= EMPTY_DEBOUNCE then
						if watchArmed then
							watchArmed = false
							firstSkip = true
							onTargetsGone() -- одно «пропадание всех целей»
						end
						if state.autoSkip then
							local due = firstSkip or (state.skipRepeat and now - lastSkip >= SKIP_COOLDOWN)
							if due then
								firstSkip = false
								lastSkip = now
								if fireSkip() then
									flashFarm("Skip отправлен")
								end
							end
						end
					end
				end
			end
		else
			emptySince = nil
		end
		task.wait(0.3)
	end
end

local function startFarmLoops()
	farmGen += 1
	local gen = farmGen
	task.spawn(clickLoop, gen)
	task.spawn(watchLoop, gen)
end

local function stopFarmLoops()
	farmGen += 1
end

local function setFarm(on)
	state.farm = on
	if on then
		startFarmLoops()
	else
		stopFarmLoops()
		deathToken += 1 -- прерываем действия после смерти
	end
	refreshFarmBtn()
end

local function destroyFarmButton()
	for _, c in ipairs(farmConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(farmConns)
	if farmBtn then
