-- Режим СБРОСА: ресет персонажа (убить и возродить)
------------------------------------------------------------
M.resetBusy = false
M.goneCount = 0       -- сколько раз пропадали все цели с прошлого цикла
M.cyclesDone = 0      -- сколько циклов сброса запущено
M.refreshResetInfo = nil -- назначается позже (обновляет строку состояния в меню)

function M.resetCharacter()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	pcall(function() hum.Health = 0 end)
	pcall(function() char:BreakJoints() end)
	return true
end

-- цикл: первый ресет сразу, второй через state.resetDelay секунд
function M.runResetCycle()
	if M.resetBusy or not state.alive then return end
	M.resetBusy = true
	M.cyclesDone += 1
	if M.refreshResetInfo then M.refreshResetInfo() end
	task.spawn(function()
		M.resetCharacter() -- первый ресет
		local t0 = os.clock()
		while state.alive and os.clock() - t0 < state.resetDelay do
			task.wait(0.1)
		end
		if state.alive then
			M.resetCharacter() -- второй ресет
		end
		M.resetBusy = false
		if M.refreshResetInfo then M.refreshResetInfo() end
	end)
end

-- вызывается один раз при каждом «пропадании всех целей»
function M.onTargetsGone()
	if not state.resetEnabled then return end
	M.goneCount += 1
	if M.goneCount >= state.resetEvery then
		M.goneCount = 0
		M.runResetCycle()
	end
	if M.refreshResetInfo then M.refreshResetInfo() end
end

