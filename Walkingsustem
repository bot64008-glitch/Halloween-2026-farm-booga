		box.AnchorPoint = Vector2.new(1, 0.5)
		box.Position = UDim2.new(1, -30, 0.5, 0)
		box.Size = UDim2.fromOffset(34, 22)
		box.BackgroundColor3 = C.bg
		box.BorderSizePixel = 0
		box.Font = Enum.Font.GothamBold
		box.TextSize = 11
		box.TextColor3 = C.yellow
		box.ClearTextOnFocus = true
		box.Text = ""
		box.Parent = frame
		Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
		r.plus, r.minus, r.box = plus, minus, box

		r.conns[#r.conns + 1] = nameBtn.Activated:Connect(function()
			if state.priorities[key] then
				setLevel(key, 0)
			else
				setLevel(key, state.newPriorityLevel)
			end
		end)
		r.conns[#r.conns + 1] = plus.Activated:Connect(function()
			setLevel(key, (state.priorities[key] or 0) + 1)
		end)
		r.conns[#r.conns + 1] = minus.Activated:Connect(function()
			setLevel(key, (state.priorities[key] or 1) - 1)
		end)
		r.conns[#r.conns + 1] = box.FocusLost:Connect(function()
			local n = tonumber((box.Text:gsub(",", ".")))
			if n then
				setLevel(key, n)
			elseif M.refreshPriorityList then
				M.refreshPriorityList()
			end
		end)
		rows[key] = r
	end

	local function updateRow(key, rank)
		local r = rows[key]
		local level = state.priorities[key]
		local present = M.presentNow[key]
		r.frame.LayoutOrder = 100 + rank
		r.nameBtn.Text = (present and "● " or "   ") .. (M.seenNames[key] or key)
		r.nameBtn.TextColor3 = level and C.yellow or (present and C.text or C.sub)
		r.frame.BackgroundColor3 = level and Color3.fromRGB(46, 41, 20) or C.card
		r.plus.Visible = level ~= nil
		r.minus.Visible = level ~= nil
		r.box.Visible = level ~= nil
		if not r.box:IsFocused() then
			r.box.Text = level and tostring(level) or ""
		end
	end

	M.refreshPriorityList = function()
		local filter = nameBox.Text:lower()
		local keys = {}
		for k in pairs(M.seenNames) do keys[k] = true end
		for k in pairs(state.priorities) do keys[k] = true end

		local list = {}
		for k in pairs(keys) do
			if filter == "" or k:find(filter, 1, true) then
				list[#list + 1] = k
			end
		end
		table.sort(list, function(a, b)
			local la, lb = state.priorities[a] or 0, state.priorities[b] or 0
			if la ~= lb then return la > lb end
			local pa, pb = M.presentNow[a] and 1 or 0, M.presentNow[b] and 1 or 0
			if pa ~= pb then return pa > pb end
			return a < b
		end)

		local shown = {}
		for i = 1, math.min(#list, MAX_ROWS) do
			local k = list[i]
			shown[k] = true
			if not rows[k] then
				createRow(k)
			end
			updateRow(k, i)
		end
		for k in pairs(rows) do
			if not shown[k] then
				destroyRow(k)
			end
		end
		listHeader.Text = ("ЦЕЛИ (%d)  ( ● — сейчас рядом )"):format(#list)
	end

	local function addByName()
		local raw = trim(nameBox.Text)
		if raw == "" then return end
		local key = raw:lower()
		if not M.seenNames[key] then
			M.seenNames[key] = raw
		end
		state.priorities[key] = state.newPriorityLevel
		nameBox.Text = ""
		M.queueSave()
		M.refreshPriorityList()
	end

	track(addBtn.Activated:Connect(addByName))
	track(nameBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			addByName()
		end
	end))
	track(nameBox:GetPropertyChangedSignal("Text"):Connect(function()
		M.refreshPriorityList()
	end))

	-- пока вкладка открыта, список обновляется раз в секунду
	task.spawn(function()
		while state.alive do
			if p.frame.Visible then
				pcall(M.refreshPriorityList)
			end
			task.wait(1)
		end
	end)
	M.refreshPriorityList()
end

