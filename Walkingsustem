-- СБРОС ФАРМА: пересоздаём кнопку, циклы, списки целей, чистим память и продолжаем фарм
local lastFarmReset = 0
local function resetFarm()
	if farmResetting or not state.alive or not state.farm then return end
	farmResetting = true
	lastFarmReset = os.clock()
	task.spawn(function()
		stopFarmLoops()
		buildFarmButton()
		requestRefresh()
		rebuildHumanoidSet()
		pcall(collectgarbage, "collect")
		task.wait(FARM_RESET_PAUSE)
		resetCount += 1
		farmResetting = false
		if state.alive and state.farm then
			startFarmLoops()
		end
		refreshFarmBtn()
	end)
end

-- Монитор FPS: сброс фарма только если FPS <= FPS_RESET_BELOW держится FPS_LOW_SECONDS секунд подряд
do
	local frames, accum, lowSeconds = 0, 0, 0
	track(RunService.RenderStepped:Connect(function(dt)
		frames += 1
		accum += dt
		if accum < 1 then return end
		local fps = frames / accum
		frames, accum = 0, 0

		fpsLabel.Text = ("%d FPS"):format(math.floor(fps + 0.5))
		fpsLabel.TextColor3 = fps <= FPS_RESET_BELOW and C.yellow or C.sub

		if state.farm and state.autoReset and not farmResetting then
			if fps <= FPS_RESET_BELOW then
				lowSeconds += 1
			else
				lowSeconds = 0
			end
			if lowSeconds >= FPS_LOW_SECONDS and os.clock() - lastFarmReset >= FARM_RESET_COOLDOWN then
				lowSeconds = 0
				resetFarm()
			end
		else
			lowSeconds = 0
		end
	end))
end

