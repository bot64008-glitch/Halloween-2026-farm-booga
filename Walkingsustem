function M.refreshFarmBtn()
	if not M.farmBtn then return end
	local on = state.farm
	if M.farmResetting and on then
		M.farmBtn.Text = "СБРОС ФАРМА..."
		M.farmBtn.BackgroundColor3 = C.btn
		M.farmBtn.TextColor3 = C.yellow
		return
	end
	local suffix = (on and M.resetCount > 0) and ("  (сбросов: " .. M.resetCount .. ")") or ""
	M.farmBtn.Text = (on and "ФАРМ: ВКЛ" or "ФАРМ: ВЫКЛ") .. suffix
	M.farmBtn.TextColor3 = on and C.black or C.text
	TweenService:Create(M.farmBtn, TweenInfo.new(0.12), {
		BackgroundColor3 = on and C.yellow or C.btn,
	}):Play()
end

function M.flashFarm(text)
	if M.farmBtn then
		M.farmBtn.Text = text
	end
	task.delay(0.8, function()
		if state.alive then M.refreshFarmBtn() end
	end)
end

-- цикл авто-кликера (постоянные клики)
function M.clickLoop(gen)
	while state.alive and state.farm and gen == M.farmGen do
		if state.autoClick then
			M.clickCenter()
			task.wait(1 / math.max(1, state.clicksPerSec))
		else
			task.wait(0.2)
		end
	end
end

-- цикл слежения: пропадание всех целей -> скип и/или счётчик сброса
function M.watchLoop(gen)
	local emptySince = nil
	local lastSkip = 0
	local firstSkip = false
	while state.alive and state.farm and gen == M.farmGen do
		if (state.autoSkip or state.resetEnabled) and M.candidatesReady and not M.searchNote then
			local root = M.getMyRoot()
			if root then
				if M.hasTargetsInRadius(root.Position) then
					emptySince = nil
					M.watchArmed = true
				else
					local now = os.clock()
					emptySince = emptySince or now
					if now - emptySince >= M.EMPTY_DEBOUNCE then
						if M.watchArmed then
							M.watchArmed = false
							firstSkip = true
							M.onTargetsGone() -- одно «пропадание всех целей»
						end
						if state.autoSkip then
							local due = firstSkip or (state.skipRepeat and now - lastSkip >= M.SKIP_COOLDOWN)
							if due then
								firstSkip = false
								lastSkip = now
								if M.fireSkip() then
									M.flashFarm("Skip отправлен")
								end
							end
						end
					end
				end
			end
		else
			emptySince = nil
		end
		task.wait(0.3)
	end
end

function M.startFarmLoops()
	M.farmGen += 1
	local gen = M.farmGen
	task.spawn(M.clickLoop, gen)
	task.spawn(M.watchLoop, gen)
end

function M.stopFarmLoops()
	M.farmGen += 1
end

function M.setFarm(on)
	state.farm = on
	if on then
		M.startFarmLoops()
	else
		M.stopFarmLoops()
		M.deathToken += 1 -- прерываем действия после смерти
	end
	M.refreshFarmBtn()
end

function M.destroyFarmButton()
	for _, c in ipairs(M.farmConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(M.farmConns)
	if M.farmBtn then
		M.farmBtn:Destroy()
		M.farmBtn = nil
	end
end

function M.buildFarmButton()
	M.destroyFarmButton()
	M.farmBtn = makeButton(M.pageMain.frame, "", C.btn, C.text, UDim2.new(1, 0, 0, 38), M.farmConns)
	M.farmBtn.LayoutOrder = M.farmOrder
	M.farmConns[#M.farmConns + 1] = M.farmBtn.Activated:Connect(function()
		M.setFarm(not state.farm)
	end)
	M.refreshFarmBtn()
end

function M.rebuildHumanoidSet()
	table.clear(M.npcHumanoids)
	local n = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		n += 1
		if n % 1000 == 0 then
			task.wait()
			if not state.alive then return end
		end
		M.addHumanoid(inst)
	end
end

-- СБРОС ФАРМА: пересоздаём кнопку, циклы, списки целей, чистим память и продолжаем фарм
M.lastFarmReset = 0
function M.resetFarm()
	if M.farmResetting or not state.alive or not state.farm then return end
	M.farmResetting = true
	M.lastFarmReset = os.clock()
	task.spawn(function()
		M.stopFarmLoops()
		M.buildFarmButton()
		M.requestRefresh()
		M.rebuildHumanoidSet()
		pcall(collectgarbage, "collect")
		task.wait(M.FARM_RESET_PAUSE)
		M.resetCount += 1
		M.farmResetting = false
		if state.alive and state.farm then
			M.startFarmLoops()
		end
		M.refreshFarmBtn()
	end)
end

-- Монитор FPS: сброс фарма только если FPS <= FPS_RESET_BELOW держится FPS_LOW_SECONDS секунд подряд
do
	local frames, accum, lowSeconds = 0, 0, 0
	track(RunService.RenderStepped:Connect(function(dt)
		frames += 1
		accum += dt
		if accum < 1 then return end
		local fps = frames / accum
		frames, accum = 0, 0

		M.fpsLabel.Text = ("%d FPS"):format(math.floor(fps + 0.5))
		M.fpsLabel.TextColor3 = fps <= M.FPS_RESET_BELOW and C.yellow or C.sub

		if state.farm and state.autoReset and not M.farmResetting then
			if fps <= M.FPS_RESET_BELOW then
				lowSeconds += 1
			else
				lowSeconds = 0
			end
			if lowSeconds >= M.FPS_LOW_SECONDS and os.clock() - M.lastFarmReset >= M.FARM_RESET_COOLDOWN then
				lowSeconds = 0
				M.resetFarm()
			end
		else
			lowSeconds = 0
		end
	end))
end

