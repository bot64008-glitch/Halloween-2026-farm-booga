-- Движение
------------------------------------------------------------
local BIND_NAME = "NPCWalkerMove"
local currentTarget = nil
local lastRetarget = 0
local stuckTime = 0
local isBound = false
local retreating = false

local zoneActive = false
local zoneArmed = true
local noTargetTime = 0
local zoneRecoverTime = 0
local lastChar = nil

local function setAutoRotate(value)
	local hum = getMyHumanoid()
	if hum then
		hum.AutoRotate = value
	end
end

local function stopMoving()
	local hum = getMyHumanoid()
	if hum then
		hum:Move(Vector3.zero, false)
	end
end

local function unbindMove()
	if isBound then
		isBound = false
		pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
	end
end

local function targetValid(t)
	return t ~= nil and t.inst.Parent ~= nil and t.root.Parent ~= nil and isAlive(t.inst)
end

local function checkStuck(hum, root, dt, cond)
	if state.autoJump and cond then
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		if speed < 1.5 then
			stuckTime += dt
			if stuckTime > 0.35 then
				hum.Jump = true
				stuckTime = 0
			end
		else
			stuckTime = 0
		end
	else
		stuckTime = 0
	end
end

local function resetLatches()
	retreating = false
	zoneActive = false
	zoneArmed = true
	noTargetTime = 0
	zoneRecoverTime = 0
end

local function step(dt)
	if not (state.alive and state.running) then return end

	-- новый персонаж (смерть/респавн): сбрасываем зону и отход — в зону после смерти не идём
	local char = player.Character
	if char ~= lastChar then
		lastChar = char
		resetLatches()
		glideVel = Vector3.zero
	end

	local hum, root = getMyHumanoid(), getMyRoot()
	if not hum or not root or hum.Health <= 0 then
		currentTarget = nil
		resetLatches()
		glideVel = Vector3.zero
		setStatus("Ждём персонажа...", C.sub)
		return
	end

	-- поворотом занимаемся сами, если включено «смотреть на цель»
	if state.face then
		if hum.AutoRotate then hum.AutoRotate = false end
	elseif not hum.AutoRotate then
		hum.AutoRotate = true
	end

	local hp = hum.Health

	-- ближайший NPC (пересчёт несколько раз в секунду или сразу, если цель пропала)
	local now = os.clock()
	if not targetValid(currentTarget) or now - lastRetarget > 0.15 then
		currentTarget = findNearest(root.Position)
		lastRetarget = now
	end
	local target = currentTarget

	-- безопасная зона: включаем при HP <= zoneHp, снимаем когда пропали все цели
	-- или когда HP выше порога держится zoneRecover секунд ПОДРЯД, пока персонаж стоит в зоне
	if state.zoneEnabled then
		if zoneActive then
			if not target and candidatesReady then
				noTargetTime += dt
				if noTargetTime >= ZONE_RELEASE_DELAY then
					zoneActive = false
					zoneArmed = false
					noTargetTime = 0
				end
			else
				noTargetTime = 0
			end

			if zoneActive then
				if hp > state.zoneHp and pointInZone(root.Position) then
					zoneRecoverTime += dt
					if zoneRecoverTime >= state.zoneRecover then
						zoneActive = false
						zoneArmed = true
						zoneRecoverTime = 0
						noTargetTime = 0
					end
				else
					zoneRecoverTime = 0
				end
			end
		else
			if hp > state.zoneHp then
				zoneArmed = true
			elseif zoneArmed and hp <= state.zoneHp then
				zoneActive = true
				noTargetTime = 0
				zoneRecoverTime = 0
			end
		end
	else
		zoneActive = false
	end

	-- отход: включаем при HP <= retreatHp, выключаем когда HP стало выше
	if state.retreat then
		if not retreating and hp <= state.retreatHp then
			retreating = true
		elseif retreating and hp > state.retreatHp then
			retreating = false
		end
	else
		retreating = false
	end

	-- направление на цель и поворот лицом к ней
	local flat = nil
	if target then
		local offset = target.root.Position - root.Position
		flat = Vector3.new(offset.X, 0, offset.Z)
		if state.face then
			faceDirection(root, flat, dt)
		end
	end

	-- 1) Безопасная зона (высший приоритет)
	if zoneActive then
		local p = root.Position
		if pointInZone(p) then
			hum:Move(Vector3.zero, false)
			applyGlide(root, Vector3.zero, dt)
			stuckTime = 0
			local suffix = ""
			if hp > state.zoneHp then
				suffix = (" • выход через %d с"):format(math.ceil(state.zoneRecover - zoneRecoverTime))
			end
			setStatus(("Зона: на месте (HP %d)%s"):format(math.floor(hp), suffix), C.yellow)
		else
			local goal = zoneGoalPoint(p)
			local to = Vector3.new(goal.X - p.X, 0, goal.Z - p.Z)
			local dist = to.Magnitude
			if dist > 0.05 then
				local dir = to.Unit
				local speed = math.clamp(dist * GLIDE_K, GLIDE_MIN_SPEED, state.glideSpeed)
				hum:Move(dir, false)
				applyGlide(root, dir * speed, dt)
			else
				hum:Move(Vector3.zero, false)
				applyGlide(root, Vector3.zero, dt)
			end
			setStatus(("Зона: иду (HP %d)"):format(math.floor(hp)), C.yellow)
			checkStuck(hum, root, dt, true)
		end
		return
	end

	-- нет целей
	if not target then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		stuckTime = 0
		setStatus(searchNote or "Целей нет", C.text)
		return
	end

	-- 2) Отход от цели при низком HP (смотрим на цель, пятимся)
	if retreating then
		local away = -flat
		if away.Magnitude < 0.1 then
			local look = root.CFrame.LookVector
			away = -Vector3.new(look.X, 0, look.Z)
		end
		local dir = away.Unit
		hum:Move(dir, false)
		applyGlide(root, dir * state.glideSpeed, dt)
		setStatus(("Отход (HP %d)"):format(math.floor(hp)), C.yellow)
		checkStuck(hum, root, dt, true)
		return
	end

	-- 3) Обычное движение к цели
	local gap = edgeGap(target, root)
	local remaining = gap - state.stopDist

	if remaining <= 0.05 or flat.Magnitude < 0.1 then
		hum:Move(Vector3.zero, false)
		applyGlide(root, Vector3.zero, dt)
		stuckTime = 0
		setStatus("У цели: " .. target.name, C.text)
		return
	end

	local dir = flat.Unit
	local speed = math.clamp(remaining * GLIDE_K, GLIDE_MIN_SPEED, state.glideSpeed)
	hum:Move(dir, false)
	applyGlide(root, dir * speed, dt)
	setStatus("К цели: " .. target.name, C.yellow)

	checkStuck(hum, root, dt, gap > 3.5)
end

local function start()
	if not state.alive or state.running then return end
	if MODES_BY_ID[state.mode].needsQuery then
		local newText = queryBox.Text
		if newText ~= (state.queries[state.mode] or "") then
			state.queries[state.mode] = newText
			requestRefresh()
		end
	end
	state.running = true
	currentTarget = nil
	stuckTime = 0
	resetLatches()
	glideVel = Vector3.zero
	lastStatus = nil
	setStatus("Запуск...", C.yellow)
	unbindMove()
	isBound = true
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Last.Value, step)
end

local function stop()
	if not state.running then return end
	state.running = false
	unbindMove()
	stopMoving()
	stopGlide()
	setAutoRotate(true)
	currentTarget = nil
	resetLatches()
	setStatus("Остановлено", C.sub)
end

