-- Защита от «призрачных» целей
------------------------------------------------------------
M.hookConns = {}
M.hooked = setmetatable({}, { __mode = "k" })
M.banLog = {}

-- события смерти для цели, за которой идём
function M.hookInst(inst, hum)
	if M.hooked[inst] then return end
	if #M.hookConns > 300 then
		for _, c in ipairs(M.hookConns) do
			pcall(function() c:Disconnect() end)
		end
		table.clear(M.hookConns)
		table.clear(M.hooked)
	end
	M.hooked[inst] = true
	local function add(conn)
		M.hookConns[#M.hookConns + 1] = conn
	end
	add(inst.AncestryChanged:Connect(function()
		if inst:IsDescendantOf(workspace) then
			M.deadSet[inst] = nil -- вернулся на карту (пул) — снова живой
		else
			M.deadSet[inst] = os.clock()
		end
	end))
	add(inst.Destroying:Connect(function()
		M.deadSet[inst] = os.clock()
	end))
	if hum then
		add(hum.Died:Connect(function()
			M.deadSet[inst] = os.clock()
		end))
		add(hum.HealthChanged:Connect(function(h)
			if h <= 0 then
				M.deadSet[inst] = os.clock()
			else
				M.deadSet[inst] = nil
			end
		end))
	end
	for _, n in ipairs(M.HP_NAMES) do
		add(inst:GetAttributeChangedSignal(n):Connect(function()
			local a = inst:GetAttribute(n)
			if type(a) == "number" then
				M.deadSet[inst] = (a <= 0) and os.clock() or nil
			end
		end))
	end
end

-- есть ли у модели хоть одна видимая часть
function M.hasVisibleParts(inst)
	if inst:IsA("BasePart") then
		return inst.Transparency < 0.95
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.95 then
			return true
		end
	end
	return false
end

-- проигрываются ли анимации: true / false, nil — если Animator не найден
function M.animActive(inst)
	local ok, res = pcall(function()
		local animator = inst:FindFirstChildWhichIsA("Animator", true)
		if not animator then return nil end
		return #animator:GetPlayingAnimationTracks() > 0
	end)
	if ok then return res end
	return nil
end

-- подробное описание цели (для диагностики)
function M.describeTarget(c)
	local lines = {}
	local function add(text)
		lines[#lines + 1] = text
	end
	pcall(function()
		local inst = c.inst
		add(("Имя: %s (%s)"):format(inst.Name, inst.ClassName))
		add("Путь: " .. inst:GetFullName())
		add("В workspace: " .. tostring(inst:IsDescendantOf(workspace)))
		local hum = inst:FindFirstChildOfClass("Humanoid")
		if hum then
			add(("Humanoid: HP %.1f / %.1f, состояние %s"):format(hum.Health, hum.MaxHealth, tostring(hum:GetState())))
		else
			add("Humanoid: нет" .. (c.hum and " (был при поиске!)" or ""))
		end
		add("HP-данные: " .. tostring(M.hpSignature(inst)))
		local attrs = {}
		for k, v in pairs(inst:GetAttributes()) do
			attrs[#attrs + 1] = k .. "=" .. tostring(v)
		end
		add("Атрибуты: " .. (#attrs > 0 and table.concat(attrs, ", ") or "нет"))
		local kids = {}
		for i, ch in ipairs(inst:GetChildren()) do
			if i > 25 then
				kids[#kids + 1] = "..."
				break
			end
			kids[#kids + 1] = ch.Name .. ":" .. ch.ClassName
		end
		add("Дети: " .. table.concat(kids, ", "))
		local r = c.root
		add(("Root: %s, поз %s, Anchored=%s"):format(r.Name, tostring(r.Position), tostring(r.Anchored)))
		add("Видимые части: " .. tostring(M.hasVisibleParts(inst)))
		add("Анимации идут: " .. tostring(M.animActive(inst)))
		add(("candAlive=%s, isAlive=%s, deadSet=%s, banned=%s"):format(
			tostring(M.candAlive(c)), tostring(M.isAlive(inst)), tostring(M.deadSet[inst] ~= nil), tostring(M.isBanned(c))
		))
	end)
	return table.concat(lines, "\n")
end

-- временно пропускаем цель и записываем причину + снимок
function M.banTarget(target, reason)
	M.blacklist[target.inst] = os.clock() + M.GHOST_BAN_SECONDS
	table.insert(M.banLog, 1, { name = target.name, reason = reason, dump = M.describeTarget(target) })
	if #M.banLog > 5 then
		table.remove(M.banLog)
	end
	M.currentTarget = nil
	M.ghostTarget = nil
	M.watchTarget = nil
	M.progBestGap = nil
	M.setStatus(("Пропущена цель %s: %s"):format(target.name, reason), C.yellow)
end

-- быстрые проверки текущей цели; возвращает причину или nil
function M.guardTarget(target, now)
	local inst, troot = target.inst, target.root
	if state.posCheck then
		local pos = troot.Position
		if pos ~= pos or pos.Y < workspace.FallenPartsDestroyHeight + 10 then
			return "позиция цели вне карты"
		end
	end
	if now - M.lastGuardCheck >= 0.5 then
		M.lastGuardCheck = now
		if state.visCheck then
			if M.hasVisibleParts(inst) then
				M.visFailCount = 0
			else
				M.visFailCount += 1
				if M.visFailCount >= 3 then
					return "у цели нет видимых частей"
				end
			end
		end
		if state.animCheck then
			if M.animActive(inst) == false then
				M.animFailCount += 1
				if M.animFailCount >= 6 then
					return "нет проигрываемых анимаций (3 с)"
				end
			else
				M.animFailCount = 0
			end
		end
	end
	return nil
end

------------------------------------------------------------
-- Маршрут боссов: геометрия зоны и скольжение к точке
------------------------------------------------------------
M.BOSS_APPROACH_BASE = 15  -- запас времени на «подойти к боссу» (плюс время пути)
M.BOSS_HYST = 4            -- гистерезис «рядом с зоной» (студы)

-- расстояние от точки до зоны (0 — внутри)
function M.zoneDistance(p)
	if M.pointInZone(p) then return 0 end
	local best
	for i = 1, #M.ZONE_POINTS do
		local a = M.ZONE_POINTS[i]
		local b = M.ZONE_POINTS[(i % #M.ZONE_POINTS) + 1]
		local c = M.closestOnSegment(p, a, b)
		local d = math.sqrt((c.X - p.X) ^ 2 + (c.Z - p.Z) ^ 2)
		if not best or d < best then
			best = d
		end
	end
	return best
end

-- ближайшая к p точка внутри зоны
function M.clampToZone(p)
	if M.pointInZone(p) then
		return Vector3.new(p.X, 0, p.Z)
	end
	return M.zoneGoalPoint(p)
end

function M.flatDist(a, b)
	return math.sqrt((a.X - b.X) ^ 2 + (a.Z - b.Z) ^ 2)
end

-- самый дальний от цели угол зоны (индекс) и расстояние до него
function M.farCornerIndex(tpos)
	local bestI, bestD
	for i, pt in ipairs(M.ZONE_POINTS) do
		local d = M.flatDist(pt, tpos)
		if not bestD or d > bestD then
			bestI, bestD = i, d
		end
	end
	return bestI, bestD
end

-- точка чуть внутри зоны у угла
function M.cornerPoint(i)
	local pt = M.ZONE_POINTS[i]
	local flatPt = Vector3.new(pt.X, 0, pt.Z)
	local toCenter = M.ZONE_CENTER - flatPt
	if toCenter.Magnitude < 0.01 then return flatPt end
	return flatPt + toCenter.Unit * math.min(M.ZONE_INSET + 0.5, toCenter.Magnitude)
end

-- плавно скользим к точке; возвращает true, если уже на месте
function M.glideToPoint(hum, root, goal, dt)
	local p = root.Position
	local to = Vector3.new(goal.X - p.X, 0, goal.Z - p.Z)
	local dist = to.Magnitude
	if dist < 0.6 then
		hum:Move(Vector3.zero, false)
		M.applyGlide(root, Vector3.zero, dt)
		return true
	end
	local dir = to.Unit
	hum:Move(dir, false)
	M.applyGlide(root, dir * M.approachSpeed(dist), dt)
	return false
end

local function step(dt)
	if not (state.alive and state.running) then return end

	-- новый персонаж (смерть/респавн): сбрасываем зону и отход — в зону после смерти не идём
	local char = player.Character
	if char ~= M.lastChar then
		M.lastChar = char
		M.resetLatches()
		M.glideVel = Vector3.zero
	end

	local hum, root = M.getMyHumanoid(), M.getMyRoot()
	if not hum or not root or hum.Health <= 0 then
		M.currentTarget = nil
		M.resetLatches()
		M.glideVel = Vector3.zero
		M.setStatus("Ждём персонажа...", C.sub)
		return
	end

	-- поворотом занимаемся сами, если включено «смотреть на цель»
	if state.face then
		if hum.AutoRotate then hum.AutoRotate = false end
	elseif not hum.AutoRotate then
		hum.AutoRotate = true
	end

	local hp = hum.Health

	-- ближайший NPC (пересчёт несколько раз в секунду или сразу, если цель пропала)
	local now = os.clock()
	local bossLocked = M.bossSpec(M.currentTarget) ~= nil -- босс «залипает»: не переключаемся, пока он жив
	if not M.targetValid(M.currentTarget) or (not bossLocked and now - M.lastRetarget > 0.15) then
		M.currentTarget = M.findNearest(root.Position)
		M.lastRetarget = now
	end
	local target = M.currentTarget

	-- слежение за целью: подписка на события смерти и проверки «призрака»
	if target then
		if target ~= M.watchTarget then
			M.watchTarget = target
			M.progBestGap, M.progSince, M.visFailCount, M.animFailCount = nil, now, 0, 0
			M.ghostTarget = nil
			if state.deathEvents then
				M.hookInst(target.inst, target.hum)
			end
		end
		local reason = M.guardTarget(target, now)
		if reason then
			M.banTarget(target, reason)
			target = nil
		end
	end

	-- безопасная зона: включаем при HP <= zoneHp, снимаем когда пропали все цели
	-- или когда HP выше порога держится zoneRecover секунд ПОДРЯД, пока персонаж стоит в зоне
	if state.zoneEnabled then
		if M.zoneActive then
			if not target and M.candidatesReady then
				M.noTargetTime += dt
				if M.noTargetTime >= M.ZONE_RELEASE_DELAY then
					M.zoneActive = false
					M.zoneArmed = false
					M.noTargetTime = 0
				end
			else
				M.noTargetTime = 0
			end

			if M.zoneActive then
				if hp > state.zoneHp and M.pointInZone(root.Position) then
					M.zoneRecoverTime += dt
					if M.zoneRecoverTime >= state.zoneRecover then
						M.zoneActive = false
						M.zoneArmed = true
						M.zoneRecoverTime = 0
						M.noTargetTime = 0
					end
				else
					M.zoneRecoverTime = 0
				end
			end
		else
			if hp > state.zoneHp then
				M.zoneArmed = true
			elseif M.zoneArmed and hp <= state.zoneHp then
				M.zoneActive = true
				M.noTargetTime = 0
				M.zoneRecoverTime = 0
			end
		end
	else
		M.zoneActive = false
	end

	-- отход: включаем при HP <= retreatHp, выключаем когда HP стало выше
	if state.retreat then
		if not M.retreating and hp <= state.retreatHp then
			M.retreating = true
		elseif M.retreating and hp > state.retreatHp then
			M.retreating = false
		end
	else
		M.retreating = false
	end

	-- направление на цель и поворот лицом к ней
	local flat = nil
	if target then
		local offset = target.root.Position - root.Position
		flat = Vector3.new(offset.X, 0, offset.Z)
		if state.face then
			M.faceDirection(root, flat, dt)
		end
	end

	-- 1) Безопасная зона (высший приоритет)
	if M.zoneActive then
		M.progBestGap = nil
		local p = root.Position
		if M.pointInZone(p) then
			hum:Move(Vector3.zero, false)
			M.applyGlide(root, Vector3.zero, dt)
			M.stuckTime = 0
			local suffix = ""
			if hp > state.zoneHp then
				suffix = (" • выход через %d с"):format(math.ceil(state.zoneRecover - M.zoneRecoverTime))
			end
			M.setStatus(("Зона: на месте (HP %d)%s"):format(math.floor(hp), suffix), C.yellow)
		else
			local goal = M.zoneGoalPoint(p)
			local to = Vector3.new(goal.X - p.X, 0, goal.Z - p.Z)
			local dist = to.Magnitude
			if dist > 0.05 then
				local dir = to.Unit
				local speed = M.approachSpeed(dist)
				hum:Move(dir, false)
				M.applyGlide(root, dir * speed, dt)
			else
				hum:Move(Vector3.zero, false)
				M.applyGlide(root, Vector3.zero, dt)
			end
			M.setStatus(("Зона: иду (HP %d)"):format(math.floor(hp)), C.yellow)
			M.checkStuck(hum, root, dt, true)
		end
		return
	end

	-- нет целей
	if not target then
		hum:Move(Vector3.zero, false)
		M.applyGlide(root, Vector3.zero, dt)
		M.stuckTime = 0
		M.setStatus(M.searchNote or "Целей нет", C.text)
		return
	end

	-- 2) Отход от цели при низком HP (смотрим на цель, пятимся)
	if M.retreating then
		M.progBestGap = nil
		local away = -flat
		if away.Magnitude < 0.1 then
			local look = root.CFrame.LookVector
			away = -Vector3.new(look.X, 0, look.Z)
		end
		local dir = away.Unit
		hum:Move(dir, false)
		M.applyGlide(root, dir * state.glideSpeed, dt)
		M.setStatus(("Отход (HP %d)"):format(math.floor(hp)), C.yellow)
		M.checkStuck(hum, root, dt, true)
		return
	end

	-- 3) Особый маршрут боссов (The Undying Guardian / The Spooky Knight)
	local spec = M.bossSpec(target)
	if spec then
		if M.bossTarget ~= target then
			M.bossTarget = target
			M.bossEngaged = false
			M.bossCorner = nil
			M.bossPhaseSince = now
			if state.bossApproachFirst then
				M.bossPhase = "approach"
				local d = (target.root.Position - root.Position).Magnitude
				M.bossLimit = M.BOSS_APPROACH_BASE + (d / math.max(state.glideSpeed, 1)) * 1.5
			else
				M.bossPhase = "hold"
			end
		end
		if M.bossPhase == "approach" and now - M.bossPhaseSince > M.bossLimit then
			M.bossPhase = "hold" -- не дошли за отведённое время — всё равно уходим в зону
		end

		if M.bossPhase == "hold" then
			M.progBestGap = nil
			M.ghostTarget = nil
			local p = root.Position
			local tpos = target.root.Position

			-- всегда остаёмся в зоне; если вышли — возвращаемся
			if not M.pointInZone(p) then
				M.glideToPoint(hum, root, M.zoneGoalPoint(p), dt)
				M.setStatus("Босс: иду в зону", C.yellow)
				M.checkStuck(hum, root, dt, true)
				return
			end

			-- босс в зоне или рядом с ней? (с гистерезисом, чтобы не дёргаться на границе)
			local zd = M.zoneDistance(tpos)
			local near
			if M.bossEngaged then
				near = zd <= state.bossMargin + M.BOSS_HYST
			else
				near = zd <= state.bossMargin
			end
			M.bossEngaged = near

			if near then
				-- подходим к боссу, не выходя из зоны
				if M.edgeGap(target, root) <= state.stopDist then
					hum:Move(Vector3.zero, false)
					M.applyGlide(root, Vector3.zero, dt)
					M.stuckTime = 0
					M.setStatus("Босс: бью из зоны", C.yellow)
				else
					M.glideToPoint(hum, root, M.clampToZone(tpos), dt)
					M.setStatus("Босс: подхожу из зоны", C.yellow)
					M.checkStuck(hum, root, dt, true)
				end
				return
			end

			-- босс далеко от зоны
			if spec.corner then
				-- Undying Guardian: ждём в самом дальнем от него углу
				if not M.bossCorner or now - M.bossCornerAt > 1.5 then
					local idx, d = M.farCornerIndex(tpos)
					if not M.bossCorner then
						M.bossCorner = idx
					elseif idx ~= M.bossCorner and d > M.flatDist(M.ZONE_POINTS[M.bossCorner], tpos) + 6 then
						M.bossCorner = idx -- меняем угол только если новый заметно дальше
					end
					M.bossCornerAt = now
				end
				M.glideToPoint(hum, root, M.cornerPoint(M.bossCorner), dt)
				M.setStatus("Босс: жду в дальнем углу", C.yellow)
			else
				-- Spooky Knight: просто стоим в зоне
				hum:Move(Vector3.zero, false)
				M.applyGlide(root, Vector3.zero, dt)
				M.stuckTime = 0
				M.setStatus("Босс: жду в зоне", C.yellow)
			end
			return
		end
		-- фаза "approach": обычное движение к боссу ниже
	else
		M.bossTarget, M.bossPhase = nil, nil
	end

	-- 4) Обычное движение к цели
	local gap = M.edgeGap(target, root)
	local remaining = gap - state.stopDist

	if remaining <= 0.05 or flat.Magnitude < 0.1 then
		hum:Move(Vector3.zero, false)
		M.applyGlide(root, Vector3.zero, dt)
		M.stuckTime = 0
		M.progBestGap = nil
		if M.bossPhase == "approach" then
			M.bossPhase = "hold" -- дошли до босса — сразу уходим в зону
		end
		M.setStatus("У цели: " .. target.name, C.text)

		-- страж «у цели»: HP не меняется и цель не двигается -> «призрак»
		if state.ghostFilter then
			local sig = M.hpSignature(target.inst)
			local tpos = target.root.Position
			if M.ghostTarget ~= target then
				M.ghostTarget, M.ghostSince, M.ghostSig, M.ghostPos = target, now, sig, tpos
			else
				if sig ~= M.ghostSig or (tpos - M.ghostPos).Magnitude > 0.5 then
					M.ghostSince, M.ghostSig, M.ghostPos = now, sig, tpos
				end
				-- если у цели нет данных о HP — ждём вдвое дольше
				local limit = (sig ~= nil) and state.ghostSeconds or state.ghostSeconds * 2
				if now - M.ghostSince >= limit then
					M.banTarget(target, ("стоим у цели %d с, она не меняется"):format(limit))
					return
				end
			end
		end
		return
	end

	M.ghostTarget = nil

	-- страж прогресса: зазор должен уменьшаться, иначе цель недоступна / «призрак»
	if state.progressCheck then
		if M.progBestGap == nil or gap < M.progBestGap - 1.0 then
			M.progBestGap, M.progSince = gap, now
		elseif now - M.progSince >= state.ghostSeconds then
			M.banTarget(target, ("нет прогресса в приближении %d с (зазор %.1f)"):format(state.ghostSeconds, gap))
			return
		end
	end

	local dir = flat.Unit
	local speed = M.approachSpeed(remaining)
	hum:Move(dir, false)
	M.applyGlide(root, dir * speed, dt)
	M.setStatus("К цели: " .. target.name, C.yellow)

	M.checkStuck(hum, root, dt, gap > 3.5)
end

function M.start()
	if not state.alive or state.running then return end
	if M.MODES_BY_ID[state.mode].needsQuery then
		local newText = M.queryBox.Text
		if newText ~= (state.queries[state.mode] or "") then
			state.queries[state.mode] = newText
			M.requestRefresh()
		end
	end
	state.running = true
	M.currentTarget = nil
	M.stuckTime = 0
	M.resetLatches()
	M.glideVel = Vector3.zero
	M.lastStatus = nil
	M.setStatus("Запуск...", C.yellow)
	M.unbindMove()
	M.isBound = true
	RunService:BindToRenderStep(M.BIND_NAME, Enum.RenderPriority.Last.Value, step)
end

function M.stop()
	if not state.running then return end
	state.running = false
	M.unbindMove()
	M.stopMoving()
	M.stopGlide()
	M.setAutoRotate(true)
	M.currentTarget = nil
	M.resetLatches()
	M.setStatus("Остановлено", C.sub)
end

------------------------------------------------------------
-- Вид сверху: камера над игроком, направлена вниз на него и едет вместе с ним
------------------------------------------------------------
M.TOPVIEW_BIND = "NPCWalkerTopView"
M.topViewBound = false
M.topViewForward = Vector3.new(0, 0, -1)
M.savedCameraType = nil

function M.topViewStep()
	local camera = workspace.CurrentCamera
	local root = M.getMyRoot()
	if not camera or not root then return end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local pos = root.Position
	camera.CFrame = CFrame.lookAt(pos + Vector3.new(0, state.topViewHeight, 0), pos, M.topViewForward)
end

function M.setTopView(on)
	state.topView = on
	local camera = workspace.CurrentCamera
	if on then
		if M.topViewBound then return end
		if camera then
			M.savedCameraType = camera.CameraType
			-- направление «вверх экрана» берём из текущего взгляда камеры
			local look = camera.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			M.topViewForward = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
		end
		M.topViewBound = true
		RunService:BindToRenderStep(M.TOPVIEW_BIND, Enum.RenderPriority.Camera.Value + 1, M.topViewStep)
	else
		if M.topViewBound then
			M.topViewBound = false
			pcall(function() RunService:UnbindFromRenderStep(M.TOPVIEW_BIND) end)
		end
		if camera then
			if M.savedCameraType and M.savedCameraType ~= Enum.CameraType.Scriptable then
				camera.CameraType = M.savedCameraType
			else
				camera.CameraType = Enum.CameraType.Custom
			end
			local hum = M.getMyHumanoid()
			if hum then
				camera.CameraSubject = hum
			end
		end
	end
end

