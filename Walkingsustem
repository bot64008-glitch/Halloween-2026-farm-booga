-- цикл авто-кликера (завершается сам, если фарм выключен или цикл устарел)
local function clickLoop(gen)
	while state.alive and state.farm and gen == farmGen do
		clickCenter()
		task.wait(CLICK_INTERVAL)
	end
end

-- цикл авто-скипа (когда в радиусе нет целей)
local function skipLoop(gen)
	local emptySince = nil
	local lastSkip = 0
	while state.alive and state.farm and gen == farmGen do
		-- работаем только когда список целей собран и поиск настроен корректно
		if candidatesReady and not searchNote then
			local root = getMyRoot()
			if root then
				if hasTargetsInRadius(root.Position) then
					emptySince = nil
				else
					local now = os.clock()
					emptySince = emptySince or now
					if now - emptySince >= EMPTY_DEBOUNCE and now - lastSkip >= SKIP_COOLDOWN then
						lastSkip = now
						if fireSkip() then
							flashFarm("⏭ Skip отправлен")
						end
					end
				end
			end
		else
			emptySince = nil
		end
		task.wait(0.3)
	end
end

