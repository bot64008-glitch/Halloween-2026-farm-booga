function M.saveData()
	if not writefile then return end
	pcall(function()
		writefile(M.SAVE_FILE, HttpService:JSONEncode({ priorities = state.priorities, seen = M.seenNames }))
	end)
end

function M.queueSave()
	if M.saveQueued then return end
	M.saveQueued = true
	task.delay(1.5, function()
		M.saveQueued = false
		M.saveData()
	end)
end

function M.loadData()
	if not (readfile and isfile) then return end
	local ok, raw = pcall(function()
		if isfile(M.SAVE_FILE) then
			return readfile(M.SAVE_FILE)
		end
	end)
	if not ok or not raw then return end
	local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return end
	if type(data.priorities) == "table" then
		for k, v in pairs(data.priorities) do
			if type(k) == "string" and type(v) == "number" then
				state.priorities[k] = v
			end
		end
	end
	if type(data.seen) == "table" then
		for k, v in pairs(data.seen) do
			if type(k) == "string" and type(v) == "string" then
				M.seenNames[k] = v
			end
		end
	end
end
